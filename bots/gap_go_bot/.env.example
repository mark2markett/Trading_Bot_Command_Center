# Gap-and-go paper bot. Copy to .env. Paper fills only; Schwab is used for minute bars and quotes.
SYMBOLS=SPY,QQQ
GAP_BPS=70            # 50 for the higher-frequency variant (PF ~1.5, ~50 trades/yr)
WAIT_MIN=30
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# TOKEN_PATH=schwab_token.json   # leave unset: the fleet shares var\schwab_token.json
