# Stocks-in-Play ORB paper bot. Copy to .env.
SCANNER_URL=                      # M2M scanner endpoint returning JSON candidates (see sip_scanner.py for the contract)
SIP_SYMBOLS=                      # fallback universe if the scanner is down, e.g. TSLA,NVDA,AMD
TOP_N=20
# Schwab market data comes from M2M's token broker; this fleet holds no Schwab credential.
# Put the real values in .env.local (gitignored). Secret must be >= 32 chars.
CC_TOKEN_BROKER_URL=https://www.mark2markets.com/api/internal/schwab/access-token
CC_TOKEN_BROKER_SECRET=
# TOKEN_PATH=schwab_token.json   # leave unset: the fleet shares var\schwab_token.json
