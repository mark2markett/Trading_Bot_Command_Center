# ---- mode ----
MODE=paper                      # paper | live
# LIVE_CONFIRM=I_UNDERSTAND_THIS_IS_REAL_MONEY   # uncomment only when switching to live

# ---- strategy ----
SYMBOL=SPY
ALLOCATION_PCT=100              # % of account equity per trade
MAX_SHARES=0                    # hard cap on shares per trade, 0 = none
STOP_PCT=5                      # crash stop below entry, 0 = off
PAPER_CASH=100000

# ---- Schwab (developer.schwab.com -> create app -> "Accounts and Trading Production") ----
# Leave blank to run paper mode on free Stooq end-of-day data.
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
TOKEN_PATH=schwab_token.json
ACCOUNT_INDEX=0
PAPER_USE_SCHWAB_DATA=true

# ---- Command Center ----
# CC_VAR=C:\path\to\command-center\var      # where cc.db and control/ live (auto-detected inside the repo)
# CC_MAX_POSITION_USD=100000                # per-bot cap enforced by the risk engine
