diff --git a/cc_sdk/tests/test_daily_context_health.py b/cc_sdk/tests/test_daily_context_health.py
new file mode 100644
index 0000000..85cc0fe
--- /dev/null
+++ b/cc_sdk/tests/test_daily_context_health.py
@@ -0,0 +1,161 @@
+"""Exercise genuine runner data failures, entry suppression and heartbeat recovery."""
+import json
+from datetime import timedelta
+
+import pytest
+
+from cc_sdk.intraday import SessionRunner
+from test_session_recovery import DAY, Feed, Rules, daily_history, http_error, make_bot
+
+
+class DailyFeed(Feed):
+    def __init__(self, failed):
+        super().__init__()
+        self.failed = set(failed)
+        self.calls = []
+
+    def daily_bars(self, symbol, n):
+        self.calls.append(symbol)
+        if symbol in self.failed:
+            raise http_error(500)
+        return daily_history(DAY)
+
+
+def test_failed_daily_symbols_remain_selected_and_cannot_enter(tmp_path):
+    bot = make_bot(tmp_path)
+    feed = DailyFeed(['SPY', 'QQQ'])
+    runner = SessionRunner(bot, feed, Rules(), ['SPY', 'QQQ'])
+    runner.prepare(DAY)
+    runner.step(DAY.replace(hour=10))
+    assert runner.symbols == ['SPY', 'QQQ']
+    assert set(runner._poll_errors) == {'SPY', 'QQQ'}
+    assert not bot.L.q('SELECT id FROM orders')
+    rows = bot.L.q("SELECT reason FROM decisions WHERE action='NO_DATA'")
+    assert rows and all('HTTP 500' in r['reason'] and 'must-not-log' not in r['reason'] for r in rows)
+
+
+def test_partial_context_outage_recovers_without_reloading_healthy_symbols(tmp_path):
+    bot = make_bot(tmp_path)
+    feed = DailyFeed(['SPY'])
+    runner = SessionRunner(bot, feed, Rules(), ['SPY', 'QQQ'], risk_pct=0.005)
+    now = DAY.replace(hour=10)
+    runner.prepare(now)
+    runner.step(now)
+    assert set(runner.open) == {'QQQ'}
+    assert 'SPY' in runner._poll_errors
+    feed.failed.clear()
+    runner.step(now + timedelta(seconds=15))
+    assert set(runner.open) == {'SPY', 'QQQ'}
+    assert not runner._poll_errors
+    assert feed.calls.count('QQQ') == 1
+    assert feed.calls.count('SPY') == 2
+
+
+def test_failed_context_retry_is_bounded_by_poll_interval(tmp_path):
+    feed = DailyFeed(['SPY'])
+    runner = SessionRunner(make_bot(tmp_path), feed, Rules(), ['SPY'], poll_s=15)
+    now = DAY.replace(hour=10)
+    runner.prepare(now)
+    for second in (0, 1, 14, 15, 16):
+        runner.step(now + timedelta(seconds=second))
+    assert feed.calls == ['SPY', 'SPY']
+    assert 'SPY' in runner._poll_errors
+
+
+@pytest.mark.parametrize('operation', ['kill', 'flatten', 'eod'])
+def test_missing_context_never_blocks_adopted_position_exit(tmp_path, operation):
+    bot = make_bot(tmp_path)
+    bot.set_position('SPY', 3, avg_price=100, stop_price=90)
+    feed = DailyFeed(['SPY'])
+    runner = SessionRunner(bot, feed, Rules(), ['SPY'])
+    runner.prepare(DAY)
+    if operation == 'kill':
+        (bot.control.dir / 'KILL').write_text('{}')
+    elif operation == 'flatten':
+        (bot.control.dir / f'{bot.m.id}.flatten').write_text('{}')
+    runner.step(DAY.replace(hour=15 if operation == 'eod' else 10, minute=58 if operation == 'eod' else 0))
+    assert not runner.open and not bot.positions()
+    assert bot.L.one('SELECT exit_reason FROM trades')['exit_reason'] == operation
+    assert 'SPY' in runner._poll_errors
+    assert feed.calls == ['SPY']  # risk reduction precedes any context retry
+
+
+def test_valid_empty_scanner_selection_is_healthy(tmp_path):
+    runner = SessionRunner(make_bot(tmp_path), DailyFeed([]), Rules(), [], universe_fn=lambda now: [])
+    runner.prepare(DAY)
+    runner.step(DAY.replace(hour=9, minute=35))
+    assert runner.universe_done and not runner.symbols and not runner._poll_errors
+
+
+def test_late_bound_universe_retains_failed_selected_stock(tmp_path):
+    runner = SessionRunner(make_bot(tmp_path), DailyFeed(['SPY']), Rules(), [], universe_fn=lambda now: ['SPY'])
+    runner.prepare(DAY)
+    runner.step(DAY.replace(hour=9, minute=35))
+    assert runner.universe_done and runner.symbols == ['SPY']
+    assert 'SPY' in runner._poll_errors and not runner.open
+
+
+def test_real_loop_heartbeat_reports_daily_failure_then_recovery(tmp_path, monkeypatch):
+    import cc_sdk.intraday as module
+    bot = make_bot(tmp_path)
+    feed = DailyFeed(['SPY'])
+    rules = Rules()
+    rules.decide = lambda bars, ctx: None
+    runner = SessionRunner(bot, feed, rules, ['SPY'])
+    now = DAY.replace(hour=10)
+    times = iter([now, now + timedelta(minutes=5), DAY.replace(hour=16)])
+    class Clock:
+        @staticmethod
+        def now(tz):
+            return next(times)
+    monkeypatch.setattr(module, 'datetime', Clock)
+    clock = iter([1000., 1000., 1301., 1301.])
+    monkeypatch.setattr(module.time, 'time', lambda: next(clock))
+    monkeypatch.setattr(module.time, 'sleep', lambda seconds: feed.failed.clear())
+    runner.loop(DAY)
+    rows = bot.L.q('SELECT ok,detail FROM heartbeats ORDER BY id')
+    assert [r['ok'] for r in rows] == [0, 1]
+    assert 'SPY' in json.loads(rows[0]['detail'])['data_errors']
+    assert json.loads(rows[1]['detail'])['symbols'] == ['SPY']
+
+
+def test_spread_daily_context_recovery_preserves_entry_and_eod(tmp_path):
+    from cc_sdk.options_runner import SpreadSessionRunner
+    from test_options_runner import Feed as ChainFeed, Rules as SpreadRules, mk
+    class FlakyFeed(ChainFeed):
+        failed = True
+        def daily_bars(self, symbol, n):
+            if self.failed:
+                raise http_error(500)
+            return super().daily_bars(symbol, n)
+    bot, _ = mk(tmp_path)
+    feed = FlakyFeed()
+    runner = SpreadSessionRunner(bot, feed, SpreadRules(), ['SPY'], adopt_positions=False)
+    now = DAY.replace(hour=10, minute=1)
+    runner.prepare(now)
+    runner.step(now)
+    assert 'SPY' in runner._poll_errors and not bot.positions()
+    feed.failed = False
+    runner.step(now + timedelta(seconds=15))
+    assert len(bot.positions()) == 2 and not runner._poll_errors
+    runner.step(DAY.replace(hour=15, minute=58))
+    assert not bot.positions() and not runner.open
+
+
+def test_session_completion_cannot_overwrite_unresolved_data_failure(tmp_path, monkeypatch):
+    import cc_sdk.intraday as module
+    bot = make_bot(tmp_path)
+    runner = SessionRunner(bot, DailyFeed(['SPY']), Rules(), ['SPY'])
+    times = iter([DAY.replace(hour=10), DAY.replace(hour=16)])
+    class Clock:
+        @staticmethod
+        def now(tz):
+            return next(times)
+    monkeypatch.setattr(module, 'datetime', Clock)
+    monkeypatch.setattr(module.time, 'sleep', lambda seconds: None)
+    with pytest.raises(RuntimeError, match='unresolved data errors'):
+        with bot.run('session'):
+            runner.loop(DAY)
+    row = bot.L.one('SELECT ok,detail FROM heartbeats ORDER BY id DESC LIMIT 1')
+    assert row['ok'] == 0 and 'daily_bars: HTTP 500' in row['detail']
+    assert 'must-not-log' not in row['detail']
