--- /dev/null
+++ b/src/lib/sip/__tests__/service.test.ts
@@ -0,0 +1,196 @@
+import { describe, it, expect, vi } from "vitest";
+import readyFixture from "../../../../tests/fixtures/sip/sip-v1-ready.json";
+import { SipScanner, phaseAt } from "../service";
+import { machineResponse } from "../http";
+import { previousSessions, sessionTime } from "../calendar";
+import { SipUnavailable } from "../contract";
+const date = "2026-10-06",
+  now = sessionTime(date, 575);
+const daily = previousSessions(date, 40)
+  .reverse()
+  .map((d) => ({
+    t: sessionTime(d, 0).getTime(),
+    o: 10,
+    h: 10.5,
+    l: 9.5,
+    c: 10,
+    v: 1e6,
+  }));
+const bars = (d: string, v = 100) =>
+  Array.from({ length: 5 }, (_, i) => ({
+    t: sessionTime(d, 570 + i).getTime(),
+    o: 10,
+    h: 11,
+    l: 9,
+    c: 10,
+    v,
+  }));
+function fixture() {
+  const values = new Map<string, any>();
+  const store = {
+    result: vi.fn(async (d) => values.get(d + ":result") ?? null),
+    preparation: vi.fn(async (d) => values.get(d + ":prep") ?? null),
+    symbol: vi.fn(async (d, s) => values.get(d + ":" + s) ?? null),
+    saveSymbol: vi.fn(async (d, s, v) => {
+      values.set(d + ":" + s, v);
+    }),
+    savePreparation: vi.fn(async (d, v) => {
+      values.set(d + ":prep", v);
+    }),
+    saveResult: vi.fn(async (d, v) => {
+      if (!values.has(d + ":result")) values.set(d + ":result", v);
+    }),
+    withLock: vi.fn(async (d, fn) => fn("owner")),
+  };
+  const data = {
+    dailyBars: vi.fn(async () => daily),
+    historyMinutes: vi.fn(async () =>
+      previousSessions(date, 14).flatMap((d) => bars(d)),
+    ),
+    openingMinutes: vi.fn(async () => bars(date, 200)),
+    quotes: vi.fn(async (symbols) =>
+      Object.fromEntries(
+        symbols.map((s) => [s, { price: 10, at: now.getTime() }]),
+      ),
+    ),
+  };
+  const scanner = new SipScanner(data, store, ["NVDA", "AMD"], () => now);
+  return { data, store, scanner, values };
+}
+describe("preparation, completeness and publication", () => {
+  it("prepares the universe then publishes precise RVOL and immutable result", async () => {
+    const { scanner, store, data } = fixture();
+    expect((await scanner.prepare(now))?.complete).toBe(true);
+    const result = await scanner.publish(now);
+    expect(result).toEqual(readyFixture);
+    expect(result?.candidates.map((c) => c.symbol)).toEqual(["AMD", "NVDA"]);
+    expect(result?.candidates[0].rvol).toBe(2);
+    expect(result?.coverage).toEqual({
+      universe: 2,
+      eligible: 2,
+      observed: 2,
+      excluded: 0,
+    });
+    await scanner.publish(now);
+    expect(store.saveResult).toHaveBeenCalledTimes(1);
+    expect(data.openingMinutes).toHaveBeenCalledTimes(2);
+  });
+  it("retains successful preparation but never publishes through transport failures", async () => {
+    const f = fixture();
+    f.data.dailyBars.mockRejectedValueOnce(
+      new SipUnavailable("SCHWAB_HTTP_500"),
+    );
+    expect((await f.scanner.prepare(now))?.complete).toBe(false);
+    await expect(f.scanner.publish(now)).rejects.toThrow(
+      "PREPARATION_INCOMPLETE",
+    );
+    await f.scanner.prepare(now);
+    expect(f.data.dailyBars).toHaveBeenCalledTimes(3);
+  });
+  it("records history exclusions without inventing zero-volume observations", async () => {
+    const f = fixture();
+    f.data.historyMinutes.mockResolvedValue([]);
+    await f.scanner.prepare(now);
+    const r = await f.scanner.publish(now);
+    expect(r?.candidates).toEqual([]);
+    expect(r?.exclusions).toHaveLength(2);
+    expect(f.data.openingMinutes).not.toHaveBeenCalled();
+  });
+  it("retries incomplete current bars and preserves already completed observations", async () => {
+    const f = fixture();
+    await f.scanner.prepare(now);
+    f.data.openingMinutes.mockResolvedValueOnce(bars(date).slice(1));
+    await expect(f.scanner.publish(now)).rejects.toThrow(
+      "OPENING_WINDOW_INCOMPLETE",
+    );
+    expect(f.store.saveResult).not.toHaveBeenCalled();
+    await f.scanner.publish(now);
+    expect(f.data.openingMinutes).toHaveBeenCalledTimes(3);
+  });
+  it("refuses stale quotes and before-window publication", async () => {
+    const f = fixture();
+    await f.scanner.prepare(now);
+    await expect(f.scanner.publish(sessionTime(date, 574))).rejects.toThrow(
+      "OUTSIDE_PUBLISH_WINDOW",
+    );
+    f.data.quotes.mockResolvedValue({
+      NVDA: { price: 10, at: now.getTime() - 121000 },
+      AMD: { price: 10, at: now.getTime() },
+    });
+    await expect(f.scanner.publish(now)).rejects.toThrow("SCHWAB_QUOTE_STALE");
+  });
+});
+describe("machine auth and schedules", () => {
+  it("guards Eastern windows, DST and holidays", () => {
+    expect(phaseAt(sessionTime(date, 540))).toBe("prepare");
+    expect(phaseAt(sessionTime(date, 575))).toBe("publish");
+    expect(phaseAt(sessionTime(date, 580))).toBe(null);
+    expect(phaseAt(new Date("2026-11-09T14:35:00Z"))).toBe("publish");
+    expect(phaseAt(sessionTime("2026-11-26", 575))).toBe(null);
+  });
+  const secret = "s".repeat(32);
+  const env = {
+    enabled: "true",
+    secret,
+    reserved: { CRON_SECRET: "c".repeat(32) },
+  };
+  it("hides disabled and denies unauthenticated or shared credentials without storage calls", async () => {
+    const read = vi.fn();
+    expect(
+      (
+        await machineResponse(
+          new Request("https://test"),
+          { ...env, enabled: "false" },
+          read,
+          now,
+        )
+      ).status,
+    ).toBe(404);
+    expect(
+      (await machineResponse(new Request("https://test"), env, read, now))
+        .status,
+    ).toBe(401);
+    expect(
+      (
+        await machineResponse(
+          new Request("https://test", {
+            headers: { authorization: `Bearer ${secret}` },
+          }),
+          { ...env, reserved: { CRON_SECRET: secret } },
+          read,
+          now,
+        )
+      ).status,
+    ).toBe(503);
+    expect(read).not.toHaveBeenCalled();
+  });
+  it("returns pending then authenticated empty-ready from storage alone with no-store", async () => {
+    const req = new Request("https://test", {
+      headers: { authorization: `Bearer ${secret}` },
+    });
+    const read = vi
+      .fn()
+      .mockResolvedValueOnce(null)
+      .mockResolvedValueOnce({ version: 1, status: "ready", candidates: [] });
+    const pending = await machineResponse(req, env, read, now);
+    expect(pending.status).toBe(202);
+    const ready = await machineResponse(req, env, read, now);
+    expect(ready.status).toBe(200);
+    expect(ready.headers.get("Cache-Control")).toContain("no-store");
+    expect(read).toHaveBeenCalledWith(date);
+  });
+  it("does not leak storage failures", async () => {
+    const response = await machineResponse(
+      new Request("https://test", {
+        headers: { authorization: `Bearer ${secret}` },
+      }),
+      env,
+      async () => {
+        throw new Error("private");
+      },
+      now,
+    );
+    expect(response.status).toBe(503);
+    expect(await response.text()).not.toContain("private");
+  });
+});
