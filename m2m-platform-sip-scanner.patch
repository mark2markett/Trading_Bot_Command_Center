@@ -0,0 +1,64 @@
+/** Dedicated paper-fleet scanner contract. All prices/volumes originate in Schwab data. */
+export interface SipBar {
+  t: number;
+  o: number;
+  h: number;
+  l: number;
+  c: number;
+  v: number;
+}
+export interface PreparationRow {
+  symbol: string;
+  atr14: number;
+  avg_vol: number;
+  opening_mean: number;
+}
+export interface SipCandidate {
+  symbol: string;
+  price: number;
+  rvol: number;
+  atr14: number;
+  avg_vol: number;
+}
+export interface Exclusion {
+  symbol: string;
+  reason: string;
+}
+export interface SipSnapshot {
+  version: 1;
+  status: "ready";
+  session_date: string;
+  generated_at: string;
+  window_start: string;
+  window_end: string;
+  candidates: SipCandidate[];
+  coverage: {
+    universe: number;
+    eligible: number;
+    observed: number;
+    excluded: number;
+  };
+  exclusions: Exclusion[];
+}
+export interface Preparation {
+  version: 1;
+  session_date: string;
+  generated_at: string;
+  universe: string[];
+  rows: PreparationRow[];
+  exclusions: Exclusion[];
+  failures: Exclusion[];
+  complete: boolean;
+}
+export class SipExcluded extends Error {
+  constructor(public readonly code: string) {
+    super(code);
+    this.name = "SipExcluded";
+  }
+}
+export class SipUnavailable extends Error {
+  constructor(public readonly code: string) {
+    super(code);
+    this.name = "SipUnavailable";
+  }
+}
diff --git a/src/lib/sip/http.ts b/src/lib/sip/http.ts
new file mode 100644
index 00000000..7a3c784c
--- /dev/null
+++ b/src/lib/sip/http.ts
@@ -0,0 +1,69 @@
+import { timingSafeEqual } from "node:crypto";
+import { clock } from "./calendar";
+import { validSnapshot } from "./snapshot";
+export const NO_STORE = {
+  "Cache-Control": "private, no-store, max-age=0",
+  Pragma: "no-cache",
+  Vary: "Authorization",
+};
+export function safeEqual(a: string | null, b: string | undefined): boolean {
+  if (!a || !b) return false;
+  const aa = Buffer.from(a),
+    bb = Buffer.from(b);
+  return aa.length === bb.length && timingSafeEqual(aa, bb);
+}
+export interface SipAuthEnv {
+  enabled: string | undefined;
+  secret: string | undefined;
+  reserved: Record<string, string | undefined>;
+}
+export function authEnvironment(): SipAuthEnv {
+  return {
+    enabled: process.env.SIP_SCANNER_ENABLED,
+    secret: process.env.SIP_SCANNER_SECRET,
+    reserved: {
+      CRON_SECRET: process.env.CRON_SECRET,
+      DASHBOARD_PASSWORD: process.env.DASHBOARD_PASSWORD,
+      MONITOR_SECRET: process.env.MONITOR_SECRET,
+      SCHWAB_BROKER_SECRET: process.env.SCHWAB_BROKER_SECRET,
+    },
+  };
+}
+export function scannerAuthConfigured(env: SipAuthEnv): boolean {
+  return Boolean(env.secret && env.secret.length >= 32 &&
+    !Object.values(env.reserved).some((v) => safeEqual(v ?? null, env.secret)));
+}
+export async function machineResponse(
+  req: Request,
+  env: SipAuthEnv,
+  read: (date: string) => Promise<unknown>,
+  now: Date,
+): Promise<Response> {
+  const json = (
+    body: unknown,
+    status: number,
+    headers: Record<string, string> = {},
+  ) => Response.json(body, { status, headers: { ...NO_STORE, ...headers } });
+  if (env.enabled !== "true") return json({ error: "not_found" }, 404);
+  if (!scannerAuthConfigured(env))
+    return json({ error: "scanner_configuration" }, 503);
+  if (!safeEqual(req.headers.get("authorization"), `Bearer ${env.secret}`))
+    return json({ error: "unauthorized" }, 401);
+  try {
+    const date = clock(now).date;
+    const result = await read(date);
+    if (result === null)
+      return json(
+        { version: 1, status: "pending", session_date: date },
+        202,
+        { "Retry-After": "15" },
+      );
+    if (!validSnapshot(result, date)) {
+      console.error("[cc-sip]", JSON.stringify({ sessionDate: date, error: "SIP_SNAPSHOT_INVALID" }));
+      return json({ error: "scanner_unavailable" }, 503, { "Retry-After": "15" });
+    }
+    return json(result, 200);
+  } catch {
+    return json({ error: "scanner_unavailable" }, 503, { "Retry-After": "15" });
+  }
+}
diff --git a/src/lib/sip/schwab.ts b/src/lib/sip/schwab.ts
new file mode 100644
index 00000000..56906ad4
--- /dev/null
+++ b/src/lib/sip/schwab.ts
@@ -0,0 +1,148 @@
+import {
+  getAccessToken,
+  invalidateSchwabAccessToken,
+} from "@/services/schwabService";
+import { previousSessions, sessionTime } from "./calendar";
+import { SipUnavailable, type SipBar } from "./contract";
+
+export interface SipData {
+  dailyBars(symbol: string, date: string): Promise<SipBar[]>;
+  historyMinutes(symbol: string, date: string): Promise<SipBar[]>;
+  openingMinutes(symbol: string, date: string): Promise<SipBar[]>;
+  quotes(
+    symbols: string[],
+  ): Promise<Record<string, { price: number; at: number }>>;
+}
+/** Only market-data GETs. OAuth remains owned by the existing platform service. */
+export class SchwabSipData implements SipData {
+  constructor(
+    private token = getAccessToken,
+    private invalidate: () => void = invalidateSchwabAccessToken,
+    private fetcher: typeof fetch = fetch,
+    private intervalMs = 600,
+  ) {}
+  private pacing = Promise.resolve();
+  private async pace() {
+    const wait = this.pacing;
+    this.pacing = wait.then(
+      () =>
+        new Promise<void>((resolve) => setTimeout(resolve, this.intervalMs)),
+    );
+    await wait;
+  }
+  private async get(
+    path: "pricehistory" | "quotes",
+    params: Record<string, string>,
+  ): Promise<unknown> {
+    const url = new URL(`https://api.schwabapi.com/marketdata/v1/${path}`);
+    for (const [key, value] of Object.entries(params))
+      url.searchParams.set(key, value);
+    for (let attempt = 0; attempt < 2; attempt++) {
+      let response: Response;
+      try {
+        await this.pace();
+        response = await this.fetcher(url, {
+          method: "GET",
+          headers: { Authorization: `Bearer ${await this.token()}` },
+          signal: AbortSignal.timeout(20_000),
+          redirect: "error",
+          cache: "no-store",
+        });
+      } catch {
+        throw new SipUnavailable("SCHWAB_REQUEST_FAILED");
+      }
+      if (response.status === 401 && attempt === 0) {
+        this.invalidate();
+        continue;
+      }
+      if (!response.ok)
+        throw new SipUnavailable(`SCHWAB_HTTP_${response.status}`);
+      try {
+        return await response.json();
+      } catch {
+        throw new SipUnavailable("SCHWAB_SCHEMA");
+      }
+    }
+    throw new SipUnavailable("SCHWAB_AUTH_FAILED");
+  }
+  private async bars(
+    symbol: string,
+    start: number,
+    end: number,
+    frequencyType: "daily" | "minute",
+  ): Promise<SipBar[]> {
+    const data = record(
+      await this.get("pricehistory", {
+        symbol,
+        periodType: frequencyType === "daily" ? "month" : "day",
+        frequencyType,
+        frequency: "1",
+        startDate: String(start),
+        endDate: String(end),
+        needExtendedHoursData: "false",
+      }),
+    );
+    if (!Array.isArray(data.candles)) throw new SipUnavailable("SCHWAB_SCHEMA");
+    return data.candles.map((raw) => {
+      const b = record(raw);
+      const values = ["datetime", "open", "high", "low", "close", "volume"].map(
+        (key) => number(b[key]),
+      );
+      return {
+        t: values[0],
+        o: values[1],
+        h: values[2],
+        l: values[3],
+        c: values[4],
+        v: values[5],
+      };
+    });
+  }
+  dailyBars(symbol: string, date: string) {
+    const end = sessionTime(date, 0).getTime();
+    return this.bars(symbol, end - 90 * 86_400_000, end, "daily");
+  }
+  historyMinutes(symbol: string, date: string) {
+    const prior = previousSessions(date, 14);
+    return this.bars(
+      symbol,
+      sessionTime(prior[13], 570).getTime(),
+      sessionTime(prior[0], 575).getTime(),
+      "minute",
+    );
+  }
+  openingMinutes(symbol: string, date: string) {
+    return this.bars(
+      symbol,
+      sessionTime(date, 570).getTime(),
+      sessionTime(date, 575).getTime(),
+      "minute",
+    );
+  }
+  async quotes(symbols: string[]) {
+    if (!symbols.length) return {};
+    const data = record(
+      await this.get("quotes", {
+        symbols: symbols.join(","),
+        fields: "quote,reference",
+      }),
+    );
+    const result: Record<string, { price: number; at: number }> = {};
+    for (const symbol of symbols) {
+      const q = record(record(data[symbol]).quote);
+      result[symbol] = { price: number(q.lastPrice), at: number(q.quoteTime) };
+    }
+    return result;
+  }
+}
+
+function record(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw new SipUnavailable("SCHWAB_SCHEMA");
+  return value as Record<string, unknown>;
+}
+function number(value: unknown): number {
+  if (typeof value !== "number" || !Number.isFinite(value))
+    throw new SipUnavailable("SCHWAB_SCHEMA");
+  return value;
+}
diff --git a/src/lib/sip/service.ts b/src/lib/sip/service.ts
new file mode 100644
index 00000000..b25a4b8f
--- /dev/null
+++ b/src/lib/sip/service.ts
@@ -0,0 +1,210 @@
+import { clock, sessionTime } from "./calendar";
+import {
+  dailyEligibility,
+  preparationFromEligibility,
+  openingVolume,
+  rankCandidates,
+} from "./calculation";
+import {
+  SipExcluded,
+  SipUnavailable,
+  type Preparation,
+  type SipSnapshot,
+  type SipCandidate,
+} from "./contract";
+import type { SipData } from "./schwab";
+import type { SipStorage } from "./store";
+import { validSnapshot } from "./snapshot";
+export function phaseAt(now: Date): "prepare" | "publish" | null {
+  const { trading, minute } = clock(now);
+  if (!trading) return null;
+  return minute >= 540 && minute < 570
+    ? "prepare"
+    : minute >= 575 && minute < 580
+      ? "publish"
+      : null;
+}
+export class SipScanner {
+  constructor(
+    private data: SipData,
+    private store: SipStorage,
+    private universe: string[],
+    private now = () => new Date(),
+  ) {}
+  async prepare(at: Date): Promise<Preparation | null> {
+    const date = clock(at).date,
+      deadline = Date.now() + 240000;
+    return this.store.withLock(date, async (owner) => {
+      const result: Preparation = {
+        version: 1,
+        session_date: date,
+        generated_at: this.now().toISOString(),
+        universe: this.universe,
+        rows: [],
+        exclusions: [],
+        failures: [],
+        complete: false,
+      };
+      let index = 0;
+      const work = async () => {
+        while (index < this.universe.length) {
+          const symbol = this.universe[index++];
+          try {
+            const cached = await this.store.symbol(date, symbol);
+            if (cached && "row" in cached) {
+              result.rows.push(cached.row);
+              continue;
+            }
+            if (cached && "exclusion" in cached) {
+              result.exclusions.push(cached.exclusion);
+              continue;
+            }
+            if (Date.now() >= deadline) {
+              result.failures.push({ symbol, reason: "PREPARATION_BUDGET" });
+              continue;
+            }
+            const daily = await this.data.dailyBars(symbol, date);
+            const eligibility = dailyEligibility(date, daily);
+            const row = preparationFromEligibility(
+              symbol,
+              date,
+              eligibility,
+              await this.data.historyMinutes(symbol, date),
+            );
+            await this.store.saveSymbol(date, symbol, { row }, owner);
+            result.rows.push(row);
+          } catch (error) {
+            if (error instanceof SipExcluded) {
+              const exclusion = { symbol, reason: error.code };
+              await this.store.saveSymbol(date, symbol, { exclusion }, owner);
+              result.exclusions.push(exclusion);
+            } else if (
+              error instanceof SipUnavailable &&
+              error.code === "SIP_LOCK_LOST"
+            ) {
+              throw error;
+            } else {
+              result.failures.push({
+                symbol,
+                reason:
+                  error instanceof SipUnavailable
+                    ? error.code
+                    : "PREPARATION_FAILED",
+              });
+            }
+          }
+        }
+      };
+      const jobs = await Promise.allSettled(
+        Array.from({ length: 4 }, () => work()),
+      );
+      for (const job of jobs) if (job.status === "rejected") throw job.reason;
+      result.complete = result.failures.length === 0;
+      result.rows.sort((a, b) => a.symbol.localeCompare(b.symbol));
+      result.exclusions.sort((a, b) => a.symbol.localeCompare(b.symbol));
+      await this.store.savePreparation(date, result, owner);
+      return result;
+    });
+  }
+  async publish(at: Date): Promise<SipSnapshot | null> {
+    if (phaseAt(at) !== "publish")
+      throw new SipUnavailable("OUTSIDE_PUBLISH_WINDOW");
+    const date = clock(at).date,
+      deadline = Date.now() + 240000;
+    return this.store.withLock(date, async (owner) => {
+      const existing = await this.store.result(date);
+      if (existing !== null) {
+        if (!validSnapshot(existing, date))
+          throw new SipUnavailable("SIP_SNAPSHOT_INVALID");
+        return existing;
+      }
+      const prep = await this.store.preparation(date);
+      if (!prep?.complete || prep.session_date !== date)
+        throw new SipUnavailable("PREPARATION_INCOMPLETE");
+      const volumes = new Map<string, number>();
+      let index = 0;
+      const work = async () => {
+        while (index < prep.rows.length) {
+          const row = prep.rows[index++];
+          const cached = await this.store.symbol(date, `opening:${row.symbol}`);
+          if (cached && "opening_volume" in cached) {
+            volumes.set(row.symbol, cached.opening_volume);
+            continue;
+          }
+          if (Date.now() >= deadline)
+            throw new SipUnavailable("PUBLICATION_BUDGET");
+          const volume = openingVolume(
+            await this.data.openingMinutes(row.symbol, date),
+            date,
+          );
+          await this.store.saveSymbol(
+            date,
+            `opening:${row.symbol}`,
+            { opening_volume: volume },
+            owner,
+          );
+          volumes.set(row.symbol, volume);
+        }
+      };
+      // Wait for every worker to settle before releasing the lease on failure.
+      const jobs = await Promise.allSettled(
+        Array.from({ length: 4 }, () => work()),
+      );
+      for (const job of jobs) if (job.status === "rejected") throw job.reason;
+      const quotes: Record<string, { price: number; at: number }> = {};
+      for (let i = 0; i < prep.rows.length; i += 100) {
+        if (Date.now() >= deadline)
+          throw new SipUnavailable("PUBLICATION_BUDGET");
+        Object.assign(
+          quotes,
+          await this.data.quotes(
+            prep.rows.slice(i, i + 100).map((r) => r.symbol),
+          ),
+        );
+      }
+      const generated = this.now();
+      if (phaseAt(generated) !== "publish")
+        throw new SipUnavailable("PUBLICATION_TOO_LATE");
+      const candidates: SipCandidate[] = prep.rows.map((row) => {
+        const quote = quotes[row.symbol];
+        if (
+          !quote ||
+          quote.at < sessionTime(date, 575).getTime() ||
+          generated.getTime() - quote.at > 120000 ||
+          quote.at - generated.getTime() > 30000 ||
+          !Number.isFinite(quote.price) ||
+          quote.price <= 0
+        )
+          throw new SipUnavailable("SCHWAB_QUOTE_STALE");
+        return {
+          symbol: row.symbol,
+          price: quote.price,
+          rvol: volumes.get(row.symbol)! / row.opening_mean,
+          atr14: row.atr14,
+          avg_vol: row.avg_vol,
+        };
+      });
+      const priceExclusions = candidates
+        .filter((c) => c.price <= 5)
+        .map((c) => ({ symbol: c.symbol, reason: "PRICE_TOO_LOW" }));
+      const result: SipSnapshot = {
+        version: 1,
+        status: "ready",
+        session_date: date,
+        generated_at: generated.toISOString(),
+        window_start: sessionTime(date, 570).toISOString(),
+        window_end: sessionTime(date, 575).toISOString(),
+        candidates: rankCandidates(candidates),
+        coverage: {
+          universe: prep.universe.length,
+          eligible: prep.rows.length,
+          observed: volumes.size,
+          excluded: prep.exclusions.length + priceExclusions.length,
+        },
+        exclusions: [...prep.exclusions, ...priceExclusions],
+      };
+      await this.store.saveResult(date, result, owner);
+      return result;
+    });
+  }
+}
diff --git a/src/lib/sip/snapshot.ts b/src/lib/sip/snapshot.ts
new file mode 100644
index 00000000..28d76058
--- /dev/null
+++ b/src/lib/sip/snapshot.ts
@@ -0,0 +1,55 @@
+import { sessionTime } from "./calendar";
+import type { SipSnapshot } from "./contract";
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+function timestamp(value: unknown): number {
+  return typeof value === "string" && /^\d{4}-\d{2}-\d{2}T.*(?:Z|[+-]\d{2}:\d{2})$/.test(value)
+    ? Date.parse(value) : NaN;
+}
+function symbol(value: unknown): value is string {
+  return typeof value === "string" && /^[A-Z][A-Z0-9.]{0,9}$/.test(value);
+}
+
+/** Redis is an external boundary: a TypeScript annotation is not validation.
+ * This verifies the frozen v1 contract, not provider truth or consumer freshness.
+ */
+export function validSnapshot(value: unknown, date: string): value is SipSnapshot {
+  if (!record(value) || value.version !== 1 || value.status !== "ready" || value.session_date !== date)
+    return false;
+  const start = sessionTime(date, 570).getTime(), end = sessionTime(date, 575).getTime();
+  const generated = timestamp(value.generated_at);
+  if (timestamp(value.window_start) !== start || timestamp(value.window_end) !== end ||
+      !Number.isFinite(generated) || generated < end || generated >= sessionTime(date, 580).getTime())
+    return false;
+  if (!Array.isArray(value.candidates) || value.candidates.length > 20 ||
+      !Array.isArray(value.exclusions) || !record(value.coverage)) return false;
+  const coverage = value.coverage;
+  const counts = [coverage.universe, coverage.eligible, coverage.observed, coverage.excluded];
+  if (!counts.every((n) => typeof n === "number" && Number.isSafeInteger(n) && n >= 0)) return false;
+  const [universe, eligible, observed, excluded] = counts as number[];
+  if (observed !== eligible || eligible > universe || excluded > universe ||
+      value.candidates.length > observed || value.exclusions.length !== excluded) return false;
+  const symbols = new Set<string>();
+  for (const row of value.candidates) {
+    if (!record(row) || !symbol(row.symbol) || symbols.has(row.symbol) ||
+        ![row.price, row.rvol, row.atr14, row.avg_vol].every((n) => typeof n === "number" && Number.isFinite(n)))
+      return false;
+    if (!(Number(row.price) > 5 && Number(row.rvol) >= 0 && Number(row.atr14) > 0.5 && Number(row.avg_vol) >= 1_000_000))
+      return false;
+    symbols.add(row.symbol);
+  }
+  const excludedSymbols = new Set<string>();
+  let priceExcluded = 0;
+  for (const row of value.exclusions) {
+    if (!record(row) || !symbol(row.symbol) || symbols.has(row.symbol) || excludedSymbols.has(row.symbol) ||
+        typeof row.reason !== "string" || row.reason.length === 0 || row.reason.length > 100) return false;
+    excludedSymbols.add(row.symbol);
+    if (row.reason === "PRICE_TOO_LOW") priceExcluded++;
+  }
+  // Preparation exclusions partition the universe with eligible rows; price
+  // exclusions occur after those eligible rows have been observed.
+  return eligible + excluded - priceExcluded === universe &&
+    value.candidates.length === Math.min(20, observed - priceExcluded);
+}
diff --git a/src/lib/sip/store.ts b/src/lib/sip/store.ts
new file mode 100644
index 00000000..bdf2f8ee
--- /dev/null
+++ b/src/lib/sip/store.ts
@@ -0,0 +1,132 @@
+import { Redis } from "@upstash/redis";
+import { randomUUID } from "node:crypto";
+import {
+  SipUnavailable,
+  type Preparation,
+  type PreparationRow,
+  type Exclusion,
+  type SipSnapshot,
+} from "./contract";
+const TTL = 7 * 86400;
+export type PreparedSymbol =
+  | { row: PreparationRow }
+  | { exclusion: Exclusion }
+  | { opening_volume: number };
+export interface SipStorage {
+  result(date: string): Promise<SipSnapshot | null>;
+  preparation(date: string): Promise<Preparation | null>;
+  symbol(date: string, symbol: string): Promise<PreparedSymbol | null>;
+  saveSymbol(
+    date: string,
+    symbol: string,
+    value: PreparedSymbol,
+    owner: string,
+  ): Promise<void>;
+  savePreparation(
+    date: string,
+    value: Preparation,
+    owner: string,
+  ): Promise<void>;
+  saveResult(date: string, value: SipSnapshot, owner: string): Promise<void>;
+  withLock<T>(
+    date: string,
+    work: (owner: string) => Promise<T>,
+  ): Promise<T | null>;
+}
+const FENCED_SET = `if redis.call('get',KEYS[1]) ~= ARGV[1] then return -1 end
+if ARGV[3] == 'nx' then return redis.call('set',KEYS[2],ARGV[2],'EX',ARGV[4],'NX') end
+return redis.call('set',KEYS[2],ARGV[2],'EX',ARGV[4])`;
+const RELEASE = `if redis.call('get',KEYS[1]) == ARGV[1] then return redis.call('del',KEYS[1]) end return 0`;
+export class SipStore implements SipStorage {
+  constructor(private redis: Pick<Redis, "get" | "set" | "eval">) {}
+  static fromEnvironment() {
+    const url = process.env.UPSTASH_REDIS_REST_URL,
+      token = process.env.UPSTASH_REDIS_REST_TOKEN;
+    if (!url || !token) throw new SipUnavailable("SIP_STORAGE_UNCONFIGURED");
+    return new SipStore(
+      new Redis({
+        url,
+        token,
+        retry: false,
+        signal: () => AbortSignal.timeout(5000),
+      }),
+    );
+  }
+  private key(date: string, name: string) {
+    return `cc:sip:v1:${date}:${name}`;
+  }
+  private async read<T>(date: string, name: string): Promise<T | null> {
+    try {
+      return await this.redis.get<T>(this.key(date, name));
+    } catch {
+      throw new SipUnavailable("SIP_STORAGE_FAILED");
+    }
+  }
+  result(date: string) {
+    return this.read<SipSnapshot>(date, "result");
+  }
+  preparation(date: string) {
+    return this.read<Preparation>(date, "preparation");
+  }
+  symbol(date: string, symbol: string) {
+    return this.read<PreparedSymbol>(date, `symbol:${symbol}`);
+  }
+  private async write(
+    date: string,
+    name: string,
+    value: unknown,
+    owner: string,
+    immutable = false,
+  ) {
+    try {
+      const outcome = await this.redis.eval(
+        FENCED_SET,
+        [this.key(date, "lock"), this.key(date, name)],
+        [owner, JSON.stringify(value), immutable ? "nx" : "replace", TTL],
+      );
+      if (outcome === -1) throw new SipUnavailable("SIP_LOCK_LOST");
+    } catch (e) {
+      if (e instanceof SipUnavailable) throw e;
+      throw new SipUnavailable("SIP_STORAGE_FAILED");
+    }
+  }
+  saveSymbol(
+    date: string,
+    symbol: string,
+    value: PreparedSymbol,
+    owner: string,
+  ) {
+    return this.write(date, `symbol:${symbol}`, value, owner, true);
+  }
+  savePreparation(date: string, value: Preparation, owner: string) {
+    return this.write(date, "preparation", value, owner);
+  }
+  saveResult(date: string, value: SipSnapshot, owner: string) {
+    return this.write(date, "result", value, owner, true);
+  }
+  async withLock<T>(
+    date: string,
+    work: (owner: string) => Promise<T>,
+  ): Promise<T | null> {
+    const owner = randomUUID();
+    let acquired;
+    try {
+      acquired = await this.redis.set(this.key(date, "lock"), owner, {
+        nx: true,
+        ex: 330,
+      });
+    } catch {
+      throw new SipUnavailable("SIP_STORAGE_FAILED");
+    }
+    if (!acquired) return null;
+    try {
+      return await work(owner);
+    } finally {
+      try {
+        await this.redis.eval(RELEASE, [this.key(date, "lock")], [owner]);
+      } catch {
+        console.error("[cc-sip]", JSON.stringify({ sessionDate: date, error: "SIP_LOCK_RELEASE_FAILED" }));
+      }
+    }
+  }
+}
