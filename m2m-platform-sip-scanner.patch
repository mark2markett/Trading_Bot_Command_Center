@@ -0,0 +1,20 @@
+/**
+ * Server wrapper for the after-open view: loads the model and renders AfterOpenBoard. A failed load is
+ * said on the page, never hidden and never filled.
+ */
+
+import AfterOpenBoard from './AfterOpenBoard';
+import { loadAfterOpen } from '@/lib/open/afterOpenData';
+import type { AfterOpenModel } from '@/lib/open/afterOpenModel';
+
+export default async function AfterOpenView() {
+  const now = new Date();
+  const model: AfterOpenModel | null = await loadAfterOpen(now).catch(() => null);
+  if (model) return <AfterOpenBoard model={model} now={now} />;
+  return (
+    <section className="mx-auto max-w-6xl px-4 py-4" data-module="after-open" data-state="failed">
+      <h2 className="text-lg font-semibold text-m2m-ink">After the open</h2>
+      <p className="mt-2 text-[12px] text-amber-300">The after-open view could not be loaded, so no tape status is shown.</p>
+    </section>
+  );
+}
