+import { clock, previousSessions, sessionTime } from './calendar';
+import { SipExcluded, type PreparationRow, type SipBar, type SipCandidate } from './contract';
+
+function validBar(bar: SipBar): boolean {
+  return [bar.t,bar.o,bar.h,bar.l,bar.c,bar.v].every(Number.isFinite)
+    && bar.o > 0 && bar.c > 0 && bar.l > 0 && bar.h >= bar.l && bar.v >= 0;
+}
+export function stockUniverse(symbols: string[], sectors: Record<string, string>): string[] {
+  return [...new Set(symbols)].filter(s => Boolean(sectors[s]) && sectors[s] !== 'ETF/Fund').sort();
+}
+export function dailyEligibility(date: string, bars: SipBar[]): {atr14: number; avg_vol: number} {
+  const completed = bars.filter(b => Number.isFinite(b.t) && clock(new Date(b.t)).date < date).sort((a,b) => a.t-b.t);
+  const days = completed.map(b => clock(new Date(b.t)).date);
+  const needed = previousSessions(date,20).reverse();
+  if (completed.length < 20 || completed.some(b => !validBar(b)) || new Set(days).size !== days.length
+    || needed.some((day,i) => days.slice(-20)[i] !== day)) throw new SipExcluded('DAILY_HISTORY_INCOMPLETE');
+  const avg_vol = completed.slice(-20).reduce((s,b) => s+b.v,0)/20;
+  const ranges = completed.slice(1).map((b,i) => Math.max(b.h-b.l,Math.abs(b.h-completed[i].c),Math.abs(b.l-completed[i].c)));
+  let atr14 = ranges.slice(0,14).reduce((s,n)=>s+n,0)/14;
+  for (const range of ranges.slice(14)) atr14 = (atr14*13+range)/14;
+  if (avg_vol < 1_000_000) throw new SipExcluded('DAILY_LIQUIDITY');
+  if (!(atr14 > .50)) throw new SipExcluded('ATR_TOO_LOW');
+  return {atr14,avg_vol};
+}
+export function openingVolume(bars: SipBar[], date: string): number {
+  const start = sessionTime(date,570).getTime(), end = sessionTime(date,575).getTime();
+  const window = bars.filter(b => b.t >= start && b.t < end).sort((a,b)=>a.t-b.t);
+  if (window.length !== 5) throw new SipExcluded(window.length > 5 ? 'OPENING_WINDOW_INVALID' : 'OPENING_WINDOW_INCOMPLETE');
+  if (window.some((b,i) => !validBar(b) || b.t !== start+i*60_000)) throw new SipExcluded('OPENING_WINDOW_INVALID');
+  return window.reduce((s,b)=>s+b.v,0);
+}
+export function preparationFromBars(symbol: string, date: string, daily: SipBar[], minute: SipBar[]): PreparationRow {
+  const eligibility = dailyEligibility(date,daily);
+  let observations: number[];
+  try { observations = previousSessions(date,14).map(day => openingVolume(minute,day)); }
+  catch { throw new SipExcluded('OPENING_HISTORY_INCOMPLETE'); }
+  const opening_mean = observations.reduce((s,n)=>s+n,0)/14;
+  if (!(opening_mean > 0)) throw new SipExcluded('OPENING_BASELINE_ZERO');
+  return {symbol,...eligibility,opening_mean};
+}
+export function rankCandidates(rows: SipCandidate[]): SipCandidate[] {
+  return rows.filter(r => [r.price,r.rvol,r.atr14,r.avg_vol].every(Number.isFinite)
+    && r.price > 5 && r.rvol >= 0 && r.atr14 > .50 && r.avg_vol >= 1_000_000)
+    .sort((a,b)=>b.rvol-a.rvol || a.symbol.localeCompare(b.symbol)).slice(0,20);
+}
