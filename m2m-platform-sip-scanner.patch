diff --git a/src/lib/open/__tests__/afterOpen.test.ts b/src/lib/open/__tests__/afterOpen.test.ts
new file mode 100644
index 00000000..d8156389
--- /dev/null
+++ b/src/lib/open/__tests__/afterOpen.test.ts
@@ -0,0 +1,208 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import fixture from './fixtures/tape-2026-10-05.json';
+import type { MondayPlan, PlanCandidate } from '@/lib/slate/mondayPlan';
+import type { MinuteBar } from '@/lib/open/tapeFacts';
+import {
+  dailyBarDate, parseDailyVolumes, parseMinuteBars, parseTapeSnapshots, readDailyVolumes, readMinuteBars, readTapeSnapshots, resetTapeCaches, tapeCacheSizes, type TapeQuote,
+} from '@/lib/open/tapeReader';
+import { stripItem } from '@/lib/open/afterOpenModel';
+import { loadAfterOpen } from '@/lib/open/afterOpenData';
+
+type Named = { side: 'bullish' | 'bearish'; stop: number; snapshot: { last: number; open: number; prevClose: number; vwap: number; volume: number }; dailyVolumes: number[]; bars: number[][] };
+const names = fixture.names as unknown as Record<string, Named>;
+const NOW = new Date(fixture.now);
+
+const cand = (symbol: string, target: number): PlanCandidate => ({
+  setup: { id: `id-${symbol}`, symbol, direction: names[symbol].side, strategy: 'test', quality: 0, factors: 0, visibility: 'live', entryPrice: null, stop: names[symbol].stop, target, catalystText: null, structure: '', sessionDate: '2026-10-02', entryPriceSource: null, stopLossSource: null },
+  kind: 'stock', enrich: null, notEvaluated: false, checks: [], rr: null, rrNow: null, fails: 0, unknowns: 0, rankUnknowns: 0,
+});
+const plan: MondayPlan = {
+  sessionDate: '2026-10-02', nextSession: '2026-10-05', source: 'setups',
+  plan: [cand('NVDA', 253.97), cand('MMM', 173.51), cand('MARA', 12.91)],
+  alsoQualify: [cand('NBIS', 279.83), cand('MCHP', 92.13), cand('PATH', 14.93), cand('BAC', 49.26)],
+  nearMisses: [], stocks: [], etfs: [],
+  counts: { published: 0, live: 0, shadow: 0, stocks: 0, etfs: 0, stocksWithFlowSide: 0, stocksWithFlowRead: 0, notEvaluated: 0 },
+};
+const bars = (s: string): MinuteBar[] => names[s].bars.map(([t, h, l, v]) => ({ t, h, l, v }));
+const snaps = () => ({ quotes: new Map<string, TapeQuote>(Object.entries(names).map(([s, n]) => [s, { symbol: s, at: NOW.toISOString(), ...n.snapshot }])), failed: [] as string[] });
+const deps = (over = {}) => ({
+  plan: async () => plan,
+  snapshots: vi.fn(async () => snaps()),
+  minuteBars: vi.fn(async (s: string) => bars(s)),
+  dailyVolumes: vi.fn(async (s: string) => names[s].dailyVolumes),
+  contracts: vi.fn(async () => ({})),
+  vix: async () => ({ value: 15.55, changePct: -1.2 }),
+  positioning: vi.fn(async () => ({ status: 'ok' as const, bySymbol: {} })),
+  ...over,
+});
+
+describe('loadAfterOpen on real 2026-10-05 data (12:57 ET)', () => {
+  it('groups today’s qualifiers by tape status in the fixed order, keeping plan order inside a group', async () => {
+    const m = await loadAfterOpen(NOW, deps());
+    expect(m.state).toBe('session');
+    expect(m.groups.map(g => [g.status, g.rows.map(r => r.candidate.setup.symbol)])).toEqual([
+      ['confirming', ['MMM']],
+      ['waiting', ['MCHP']],
+      ['not_confirming', ['NVDA', 'MARA']],
+      ['invalidated', ['NBIS', 'PATH', 'BAC']],
+    ]);
+    expect(m.counts).toMatchObject({ confirming: 1, waiting: 1, not_confirming: 2, invalidated: 3, forming: 0, unknown: 0 });
+    const mmm = m.groups[0].rows[0];
+    expect(mmm.inPlan).toBe(true);
+    expect(mmm.rrLive).toBeCloseTo((173.51 - 162.93) / (162.93 - 157.98), 6);
+    expect(m.notes).toEqual([]);
+  });
+
+  it('a failed vendor read is named and leaves names without a reading, never filled', async () => {
+    const m = await loadAfterOpen(NOW, deps({ snapshots: vi.fn(async () => { throw new Error('down'); }), vix: async () => { throw new Error('x'); } }));
+    expect(m.notes).toEqual(expect.arrayContaining(['Live prices could not be read (vendor request failed).', 'VIX could not be read.']));
+    expect(m.groups.map(g => g.status)).toEqual(['unknown']);
+    expect(m.indices.every(i => i.changePct === null)).toBe(true);
+  });
+
+  it('short positioning is attached per symbol; a failed store read is named, never filled', async () => {
+    const pos = { symbol: 'MMM', source: 'bulk' as const, asOf: '2026-10-01', siPctFreeFloat: 2.0, siPctFreeFloatPrior: 1.96, priorAsOf: '2026-09-24', siChangePct: 2, daysToCover: 3.3, costToBorrowPct: 0.35, availVsShort: null, availabilityUnlimited: true };
+    const ok = await loadAfterOpen(NOW, deps({ positioning: vi.fn(async () => ({ status: 'ok' as const, bySymbol: { MMM: pos } })) }));
+    expect(ok.groups[0].rows[0].positioning).toEqual(pos);
+    const failed = await loadAfterOpen(NOW, deps({ positioning: vi.fn(async () => ({ status: 'read_failed' as const, bySymbol: {} })) }));
+    expect(failed.notes).toContain('Short positioning could not be read (stored Ortex data unavailable).');
+    expect(failed.groups.every(g => g.rows.every(r => r.positioning === undefined))).toBe(true);
+  });
+
+  it('a failed volume-baseline read is named and leaves volume share empty', async () => {
+    const m = await loadAfterOpen(NOW, deps({ dailyVolumes: vi.fn(async (s: string) => { if (s === 'NVDA') throw new Error('x'); return names[s].dailyVolumes; }) }));
+    expect(m.notes).toContain('The 20-day volume baseline could not be read for NVDA; volume share omitted.');
+    const nvda = m.groups.flatMap(g => g.rows).find(r => r.candidate.setup.symbol === 'NVDA');
+    expect(nvda?.facts.volumeShare).toBeNull();
+    expect(nvda?.read.status).toBe('not_confirming');
+  });
+
+  it('a partly failed snapshot read names the symbols it lost', async () => {
+    const part = snaps();
+    part.quotes.delete('BAC');
+    const m = await loadAfterOpen(NOW, deps({ snapshots: vi.fn(async () => ({ quotes: part.quotes, failed: ['BAC', 'XLK'] })) }));
+    expect(m.notes).toContain('Live prices could not be read for BAC, XLK (vendor request failed).');
+    expect(m.groups.find(g => g.status === 'unknown')?.rows.map(r => r.candidate.setup.symbol)).toEqual(['BAC']);
+  });
+
+  it('one row per symbol: a name in both the plan and also-qualify keeps its plan entry', async () => {
+    const dup = { ...plan, alsoQualify: [...plan.alsoQualify, { ...cand('MMM', 173.51), setup: { ...cand('MMM', 173.51).setup, id: 'other-MMM' } }] };
+    const d = deps({ plan: async () => dup });
+    const m = await loadAfterOpen(NOW, d);
+    const mmm = m.groups.flatMap(g => g.rows).filter(r => r.candidate.setup.symbol === 'MMM');
+    expect(mmm).toHaveLength(1);
+    expect(mmm[0]).toMatchObject({ inPlan: true });
+    expect(d.minuteBars.mock.calls.filter(c => c[0] === 'MMM')).toHaveLength(1);
+  });
+
+  it('a lower-case plan symbol is normalized once and joins every read', async () => {
+    const lower = { ...plan, plan: [{ ...cand('MMM', 173.51), setup: { ...cand('MMM', 173.51).setup, symbol: 'mmm' } }], alsoQualify: [] };
+    const d = deps({ plan: async () => lower });
+    const m = await loadAfterOpen(NOW, d);
+    expect(d.minuteBars.mock.calls[0][0]).toBe('MMM');
+    expect(m.groups[0]).toMatchObject({ status: 'confirming' });
+  });
+
+  it('a plan read that throws is the same no-plan state: said plainly, nothing else read', async () => {
+    const d = deps({ plan: async () => { throw new Error('db down'); } });
+    const m = await loadAfterOpen(NOW, d);
+    expect(m.state).toBe('no_plan');
+    for (const f of [d.snapshots, d.minuteBars, d.dailyVolumes, d.contracts, d.positioning]) expect(f).not.toHaveBeenCalled();
+  });
+
+  it('an unreadable plan reads nothing else and says so', async () => {
+    const d = deps({ plan: async () => ({ ...plan, source: 'unavailable' as const, plan: [], alsoQualify: [] }) });
+    const m = await loadAfterOpen(NOW, d);
+    expect(m.state).toBe('no_plan');
+    for (const f of [d.snapshots, d.minuteBars, d.dailyVolumes, d.contracts, d.positioning]) expect(f).not.toHaveBeenCalled();
+  });
+
+  it('a name whose bars fail is listed and reads unknown; the others still classify', async () => {
+    const m = await loadAfterOpen(NOW, deps({ minuteBars: vi.fn(async (s: string) => { if (s === 'MMM') throw new Error('x'); return bars(s); }) }));
+    expect(m.notes).toContain('Intraday bars could not be read for MMM.');
+    expect(m.groups.find(g => g.status === 'unknown')?.rows.map(r => r.candidate.setup.symbol)).toEqual(['MMM']);
+  });
+
+  it('outside the session day it makes no vendor or store read at all and says so', async () => {
+    const vix = vi.fn(async () => ({ value: 1, changePct: 1 }));
+    const d = deps({ vix });
+    const m = await loadAfterOpen(new Date('2026-10-04T16:00:00.000Z'), d);
+    expect(m.state).toBe('not_session_day');
+    expect(m.groups).toEqual([]);
+    for (const f of [d.snapshots, d.minuteBars, d.dailyVolumes, d.contracts, d.positioning, vix]) expect(f).not.toHaveBeenCalled();
+    expect(m.indices.every(i => i.changePct === null)).toBe(true);
+    expect(m.notes).toEqual([]);
+  });
+});
+
+describe('tape reader parsing', () => {
+  beforeEach(() => resetTapeCaches());
+
+  it('snapshot: live price by the Slate rule; missing day fields stay missing; no price, no row', () => {
+    const m = parseTapeSnapshots({ tickers: [
+      { ticker: 'aaa', min: { c: 10, t: 1 }, day: { o: 9, vw: 9.5, v: 100 }, prevDay: { c: 8 } },
+      { ticker: 'BBB', min: { c: 5, t: 1 }, day: {} },
+      { ticker: 'CCC', day: { o: 1, vw: 1, v: 1 }, prevDay: { c: 1 } },
+    ] });
+    expect(m.get('AAA')).toMatchObject({ last: 10, open: 9, vwap: 9.5, volume: 100, prevClose: 8 });
+    expect(Number.isNaN(m.get('BBB')!.vwap)).toBe(true);
+    expect(m.has('CCC')).toBe(false);
+  });
+
+  it('daily volumes exclude the session date and later (bars stamped at midnight ET)', () => {
+    const t = (iso: string) => Date.parse(iso);
+    expect(dailyBarDate(t('2026-10-05T04:00:00.000Z'))).toBe('2026-10-05');
+    expect(parseDailyVolumes({ results: [{ t: t('2026-10-05T04:00:00.000Z'), v: 9 }, { t: t('2026-10-02T04:00:00.000Z'), v: 2 }, { t: t('2026-10-01T04:00:00.000Z'), v: 1 }] }, '2026-10-05')).toEqual([1, 2]);
+  });
+
+  it('minute bars keep time, high, low (volume 0 when absent) and drop malformed rows', () => {
+    expect(parseMinuteBars({ results: [{ t: 1, h: 2, l: 1, v: 5 }, { t: 2, h: 3, l: 2 }, { t: 3, h: 'x', l: 1 }] })).toEqual([{ t: 1, h: 2, l: 1, v: 5 }, { t: 2, h: 3, l: 2, v: 0 }]);
+  });
+
+  it('the caches stay bounded: stale and other-date entries are dropped past 500 keys', async () => {
+    const f = vi.fn(async () => ({ results: [{ t: 1, h: 2, l: 1, v: 1 }] }));
+    for (let i = 0; i < 520; i += 1) await readMinuteBars(`A${i}`, '2026-10-05', f as never, i < 300 ? 0 : 100_000);
+    expect(tapeCacheSizes().minute).toBeLessThanOrEqual(500);
+    const g = vi.fn(async () => ({ results: [] }));
+    for (let i = 0; i < 510; i += 1) await readDailyVolumes(`B${i}`, i < 400 ? '2026-10-02' : '2026-10-05', g as never);
+    expect(tapeCacheSizes().daily).toBeLessThanOrEqual(500);
+  });
+
+  it('snapshot batches of 100: a failed batch is reported by symbol, the others still read', async () => {
+    const syms = Array.from({ length: 150 }, (_, i) => `S${i}`);
+    const f = vi.fn(async (_p: string, q: Record<string, string>) => {
+      const list = q.tickers.split(',');
+      if (list.includes('S120')) throw new Error('batch down');
+      return { tickers: list.map(t => ({ ticker: t, min: { c: 10, t: 1 }, day: { o: 9, vw: 9.5, v: 1 }, prevDay: { c: 8 } })) };
+    });
+    const r = await readTapeSnapshots(syms, f as never);
+    expect(f).toHaveBeenCalledTimes(2);
+    expect(r.quotes.size).toBe(100);
+    expect(r.failed).toHaveLength(50);
+    expect(r.failed[0]).toBe('S100');
+  });
+
+  it('minute bars are cached 60 s per symbol and date; daily volumes for the date; bad input reads nothing', async () => {
+    const f = vi.fn(async () => ({ results: [{ t: 1, h: 2, l: 1, v: 1 }] }));
+    await readMinuteBars('MMM', '2026-10-05', f as never, 1_000);
+    await readMinuteBars('MMM', '2026-10-05', f as never, 50_000);
+    expect(f).toHaveBeenCalledTimes(1);
+    await readMinuteBars('MMM', '2026-10-05', f as never, 62_000);
+    expect(f).toHaveBeenCalledTimes(2);
+    expect((f.mock.calls[0] as unknown[])[0]).toBe('/v2/aggs/ticker/MMM/range/1/minute/2026-10-05/2026-10-05');
+    const g = vi.fn(async () => ({ results: [{ t: Date.parse('2026-10-02T04:00:00.000Z'), v: 7 }] }));
+    expect(await readDailyVolumes('MMM', '2026-10-05', g as never)).toEqual([7]);
+    await readDailyVolumes('MMM', '2026-10-05', g as never);
+    expect(g).toHaveBeenCalledTimes(1);
+    expect((g.mock.calls[0] as unknown[])[0]).toBe('/v2/aggs/ticker/MMM/range/1/day/2026-08-21/2026-10-04');
+    expect(await readMinuteBars('BAD SYMBOL', '2026-10-05', f as never)).toEqual([]);
+  });
+});
+
+describe('market strip', () => {
+  it('change % and VWAP side from vendor values; missing quote stays empty', () => {
+    expect(stripItem('SPY', { last: 774.46, prevClose: 769.64, vwap: 771.82 })).toEqual({ symbol: 'SPY', changePct: expect.closeTo(0.6263, 3), vsVwap: 'above' });
+    expect(stripItem('QQQ', undefined)).toEqual({ symbol: 'QQQ', changePct: null, vsVwap: null });
+    expect(stripItem('IWM', { last: 1, prevClose: Number.NaN, vwap: Number.NaN })).toEqual({ symbol: 'IWM', changePct: null, vsVwap: null });
+  });
+});
