+import { describe, expect, it } from 'vitest';
+import { clock, previousSessions, sessionTime } from '../calendar';
+import { dailyEligibility, preparationFromBars, openingVolume, rankCandidates, stockUniverse } from '../calculation';
+import type { SipBar } from '../contract';
+
+const date = '2026-10-06';
+function daily(): SipBar[] {
+  return previousSessions(date, 40).reverse().map(day => ({t: sessionTime(day, 0).getTime(), o: 10, h: 10.5, l: 9.5, c: 10, v: 1_000_000}));
+}
+function opening(day: string, volume = 100): SipBar[] {
+  return Array.from({length: 5}, (_, i) => ({t: sessionTime(day, 570 + i).getTime(), o: 10, h: 11, l: 9, c: 10, v: volume}));
+}
+function history(): SipBar[] { return previousSessions(date, 14).flatMap(day => opening(day)); }
+
+describe('SIP completed opening-volume calculation', () => {
+  it('compares the same five minutes across exactly fourteen previous sessions', () => {
+    expect(preparationFromBars('NVDA', date, daily(), history())).toMatchObject({symbol: 'NVDA', atr14: 1, avg_vol: 1_000_000, opening_mean: 500});
+    expect(openingVolume(opening(date, 200), date)).toBe(1000);
+  });
+  it('excludes today from daily ATR and average share volume', () => {
+    const extra = {...daily()[0], t: sessionTime(date, 0).getTime(), h: 100, v: 50_000_000};
+    expect(dailyEligibility(date, [...daily(), extra])).toMatchObject({atr14: 1, avg_vol: 1_000_000});
+  });
+  it('rejects incomplete historical opening windows instead of inventing volume', () => {
+    expect(() => preparationFromBars('NVDA', date, daily(), history().slice(1))).toThrow('OPENING_HISTORY_INCOMPLETE');
+  });
+  it('rejects duplicated bars and nonfinite volume', () => {
+    expect(() => openingVolume([...opening(date), opening(date)[0]], date)).toThrow('OPENING_WINDOW_INVALID');
+    expect(() => openingVolume(opening(date).map((b,i) => i ? b : {...b,v:NaN}), date)).toThrow('OPENING_WINDOW_INVALID');
+  });
+  it('ignores premarket and the still-forming 09:35 bar', () => {
+    const extras = [569, 575].map(m => ({...opening(date)[0], t:sessionTime(date,m).getTime(),v:999_999}));
+    expect(openingVolume([...extras,...opening(date)], date)).toBe(500);
+  });
+  it('requires enough completed history and keeps the exact liquidity/ATR boundaries', () => {
+    expect(() => dailyEligibility(date,daily().slice(0,19))).toThrow('DAILY_HISTORY_INCOMPLETE');
+    expect(() => dailyEligibility(date,daily().map(b => ({...b,v:999_999})))).toThrow('DAILY_LIQUIDITY');
+    expect(() => dailyEligibility(date,daily().map(b => ({...b,h:10.25,l:9.75})))).toThrow('ATR_TOO_LOW');
+  });
+  it('does not permit a zero baseline denominator', () => {
+    expect(() => preparationFromBars('NVDA',date,daily(),history().map(b=>({...b,v:0})))).toThrow('OPENING_BASELINE_ZERO');
+  });
+  it('ranks at most twenty, price strictly above five, by RVOL then symbol', () => {
+    const row = {price:10,rvol:2,atr14:1,avg_vol:1_000_000};
+    const rows = [...Array.from({length:25},(_,i)=>({...row,symbol:'S'+String(i).padStart(2,'0')})), {...row,symbol:'FIVE',price:5}, {...row,symbol:'BAD',rvol:Infinity}];
+    const ranked = rankCandidates(rows);
+    expect(ranked).toHaveLength(20); expect(ranked[0].symbol).toBe('S00');
+    expect(ranked.some(r => r.symbol === 'FIVE' || r.symbol === 'BAD')).toBe(false);
