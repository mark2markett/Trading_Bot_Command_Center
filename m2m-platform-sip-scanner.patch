+import { authEnvironment, machineResponse } from "@/lib/sip/http";
+import { SipStore } from "@/lib/sip/store";
+export const dynamic = "force-dynamic";
+/** Machine read endpoint: stored snapshot only. No browser/session auth or provider calls. */
+export async function GET(request: Request) {
+  return machineResponse(
+    request,
+    authEnvironment(),
+    (date) => SipStore.fromEnvironment().result(date),
+    new Date(),
+  );
+}
diff --git a/src/app/the-open/_components/AfterOpenBoard.tsx b/src/app/the-open/_components/AfterOpenBoard.tsx
