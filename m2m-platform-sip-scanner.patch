+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Redis } from "@upstash/redis";
+import { SipStore } from "@/lib/sip/store";
+import { SchwabSipData } from "@/lib/sip/schwab";
+import { SipUnavailable } from "@/lib/sip/contract";
+import { sessionTime } from "@/lib/sip/calendar";
+import policies from "@/config/controlPlaneJobPolicies.json";
+import readyFixture from "../../../../../../tests/fixtures/sip/sip-v1-ready.json";
+import { GET, maxDuration } from "../route";
+
+// Persisted cron telemetry is the external boundary; scanner and lease handling
+// remain real. No production Redis or provider request is made by these tests.
+const telemetry = vi.hoisted(() => ({
+  start: vi.fn().mockResolvedValue(17),
+  finish: vi.fn().mockResolvedValue(undefined),
+}));
+vi.mock("@/lib/cronRunLog", () => ({
+  startCronRun: telemetry.start,
+  finishCronRun: telemetry.finish,
+}));
+// Configuration boundary includes one repeated stock, a fund and an unclassified symbol.
+vi.mock("@/config/watchlist", () => ({ ALL_SYMBOLS: ["AMD", "AMD", "SPY", "UNKNOWN"] }));
+vi.mock("@/config/universeSectors", () => ({ SYMBOL_SECTOR: { AMD: "Technology", SPY: "ETF/Fund" } }));
+
+describe("SIP cron outcome reporting", () => {
+  it("aligns the route ceiling with the governed dispatcher timeout", () => {
+    expect(maxDuration * 1000).toBe(policies.jobs.find((job) => job.id === "cc-sip-scanner")?.timeoutMs);
+  });
+  const request = () => new Request("https://test.invalid/api/cron/cc-sip-scanner", {
+    headers: { Authorization: "Bearer fixture-cron-secret" },
+  });
+
+  beforeEach(() => {
+    telemetry.start.mockReset().mockResolvedValue(17);
+    telemetry.finish.mockReset().mockResolvedValue(undefined);
+    vi.useFakeTimers();
+    vi.setSystemTime(sessionTime("2026-10-06", 545));
+    vi.stubEnv("CRON_SECRET", "fixture-cron-secret");
+    vi.stubEnv("SIP_SCANNER_ENABLED", "true");
+    vi.stubEnv("SIP_SCANNER_SECRET", "fixture-scanner-secret-32-characters");
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+    vi.useRealTimers();
+  });
+
+  it.each([545, 575])("records lease contention as skipped without a failure at minute %i", async (minute) => {
+    vi.setSystemTime(sessionTime("2026-10-06", minute));
+    const redis = {
+      set: vi.fn<Redis["set"]>().mockResolvedValue(null),
+      get: vi.fn<Redis["get"]>().mockResolvedValue(null),
+      eval: vi.fn<Redis["eval"]>(),
+    };
+    vi.spyOn(SipStore, "fromEnvironment").mockReturnValue(new SipStore(redis));
+
