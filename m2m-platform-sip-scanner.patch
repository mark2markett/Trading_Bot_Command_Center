+// Persisted cron telemetry is the external boundary; scanner and lease handling
+// remain real. No production Redis or provider request is made by these tests.
+const telemetry = vi.hoisted(() => ({
+  start: vi.fn().mockResolvedValue(17),
+  finish: vi.fn().mockResolvedValue(undefined),
+}));
+vi.mock("@/lib/cronRunLog", () => ({
+  startCronRun: telemetry.start,
+  finishCronRun: telemetry.finish,
+}));
+
+describe("SIP cron outcome reporting", () => {
+  const request = () => new Request("https://test.invalid/api/cron/cc-sip-scanner", {
+    headers: { Authorization: "Bearer fixture-cron-secret" },
+  });
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    vi.useFakeTimers();
+    vi.setSystemTime(sessionTime("2026-10-06", 545));
+    vi.stubEnv("CRON_SECRET", "fixture-cron-secret");
+    vi.stubEnv("SIP_SCANNER_ENABLED", "true");
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+    vi.useRealTimers();
+  });
+
+  it.each([545, 575])("records lease contention as skipped without a failure at minute %i", async (minute) => {
+    vi.setSystemTime(sessionTime("2026-10-06", minute));
+    const redis = {
+      set: vi.fn<Redis["set"]>().mockResolvedValue(null),
+      get: vi.fn<Redis["get"]>().mockResolvedValue(null),
+      eval: vi.fn<Redis["eval"]>(),
+    };
+    vi.spyOn(SipStore, "fromEnvironment").mockReturnValue(new SipStore(redis));
+
+    const response = await GET(request());
+    expect(response.status).toBe(202);
+    expect(telemetry.finish).toHaveBeenCalledWith(17, "success", expect.objectContaining({
+      status: "busy",
+    }));
+    expect(await response.json()).toMatchObject({ status: "busy", skipped: true });
+    expect(redis.eval).not.toHaveBeenCalled();
+  });
+
+  it("keeps Redis outages as failures rather than mislabeling them contention", async () => {
+    const redis = {
+      set: vi.fn<Redis["set"]>().mockRejectedValue(new Error("storage unavailable")),
+      get: vi.fn<Redis["get"]>().mockResolvedValue(null),
+      eval: vi.fn<Redis["eval"]>(),
+    };
+    vi.spyOn(SipStore, "fromEnvironment").mockReturnValue(new SipStore(redis));
+    const response = await GET(request());
+    expect(response.status).toBe(503);
+    expect(await response.json()).toEqual({ error: "SIP_STORAGE_FAILED" });
+    expect(telemetry.finish).toHaveBeenCalledWith(17, "failure", {
+      phase: "prepare", error: "SIP_STORAGE_FAILED",
+    });
+  });
+
+  it("keeps incomplete preparation as a failure when provider history is unavailable", async () => {
+    const redis = {
+      set: vi.fn<Redis["set"]>().mockResolvedValue("OK"),
+      get: vi.fn<Redis["get"]>().mockResolvedValue(null),
+      eval: vi.fn<Redis["eval"]>().mockResolvedValue(1),
+    };
+    vi.spyOn(SipStore, "fromEnvironment").mockReturnValue(new SipStore(redis));
+    vi.spyOn(SchwabSipData.prototype, "dailyBars").mockRejectedValue(
+      new SipUnavailable("SCHWAB_HTTP_429"),
+    );
+    const response = await GET(request());
+    expect(response.status).toBe(503);
+    const summary = await response.json();
+    expect(summary.status).toBe("pending");
+    expect(summary.failures).toBeGreaterThan(0);
+    expect(summary.skipped).toBeUndefined();
+    expect(telemetry.finish).toHaveBeenCalledWith(17, "failure", expect.objectContaining({
+      status: "pending", failures: summary.failures,
+    }));
+  });
+
+  it("refuses unauthenticated work before opening a cron run", async () => {
+    const response = await GET(new Request("https://test.invalid/api/cron/cc-sip-scanner"));
+    expect(response.status).toBe(401);
+    expect(telemetry.start).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/app/api/cron/cc-sip-scanner/route.ts b/src/app/api/cron/cc-sip-scanner/route.ts
