diff --git a/src/app/api/cron/cc-sip-scanner/route.ts b/src/app/api/cron/cc-sip-scanner/route.ts
new file mode 100644
index 00000000..d035322d
--- /dev/null
+++ b/src/app/api/cron/cc-sip-scanner/route.ts
@@ -0,0 +1,74 @@
+import { ALL_SYMBOLS } from "@/config/watchlist";
+import { SYMBOL_SECTOR } from "@/config/universeSectors";
+import { startCronRun, finishCronRun } from "@/lib/cronRunLog";
+import { stockUniverse } from "@/lib/sip/calculation";
+import { phaseAt, SipScanner } from "@/lib/sip/service";
+import { SchwabSipData } from "@/lib/sip/schwab";
+import { SipStore } from "@/lib/sip/store";
+import { SipExcluded, SipUnavailable } from "@/lib/sip/contract";
+import { authEnvironment, NO_STORE, safeEqual, scannerAuthConfigured } from "@/lib/sip/http";
+export const dynamic = "force-dynamic";
+// Keep this static route ceiling aligned with controlPlaneJobPolicies.json.
+export const maxDuration = 280;
+export async function GET(request: Request) {
+  const secret = process.env.CRON_SECRET;
+  if (
+    !secret ||
+    !safeEqual(request.headers.get("authorization"), `Bearer ${secret}`)
+  )
+    return Response.json(
+      { error: "unauthorized" },
+      { status: 401, headers: NO_STORE },
+    );
+  const now = new Date(),
+    phase = phaseAt(now);
+  if (process.env.SIP_SCANNER_ENABLED !== "true" || !phase)
+    return Response.json({ status: "skipped" }, { headers: NO_STORE });
+  let runId: number | null = null;
+  try {
+    runId = await startCronRun("cc-sip-scanner", { phase });
+    if (!scannerAuthConfigured(authEnvironment()))
+      throw new SipUnavailable("SIP_SCANNER_CONFIGURATION");
+    const universe = stockUniverse(ALL_SYMBOLS, SYMBOL_SECTOR);
+    const scanner = new SipScanner(
+      new SchwabSipData(),
+      SipStore.fromEnvironment(),
+      universe,
+    );
+    const result =
+      phase === "prepare"
+        ? await scanner.prepare(now)
+        : await scanner.publish(now);
+    const complete = result && ("complete" in result ? result.complete : true);
+    const summary = {
+      phase,
+      status: !result ? "busy" : !complete ? "pending" : phase === "prepare" ? "prepared" : "publish_ready",
+      ...(!result ? { skipped: true } : {}),
+      universe: universe.length,
+      classificationExcluded: new Set(ALL_SYMBOLS).size - universe.length,
+      coverage: result && "coverage" in result ? result.coverage : null,
+      failures: result && "failures" in result ? result.failures.length : 0,
+    };
+    console.info("[cc-sip]", JSON.stringify({ runId, at: now.toISOString(), ...summary }));
+    // An owned overlapping run is already doing the work. Keep contention
+    // visible as busy/skipped without triggering the cron failure feed.
+    await finishCronRun(runId, !result || complete ? "success" : "failure", { cronName: "cc-sip-scanner", ...summary });
+    return Response.json(summary, {
+      status: !result ? 202 : complete ? 200 : 503,
+      headers: NO_STORE,
+    });
+  } catch (error) {
+    const code =
+      error instanceof SipUnavailable || error instanceof SipExcluded
+        ? error.code
+        : "SIP_SCANNER_FAILED";
+    console.error("[cc-sip]", JSON.stringify({ runId, phase, error: code }));
+    try {
+      // A null ID lets the existing helper attempt a terminal fallback row.
+      await finishCronRun(runId, "failure", { cronName: "cc-sip-scanner", phase, error: code });
+    } catch {
+      console.error("[cc-sip]", JSON.stringify({ runId, phase, error: "SIP_TELEMETRY_FAILED" }));
+    }
+    return Response.json({ error: code }, { status: 503, headers: NO_STORE });
+  }
+}
