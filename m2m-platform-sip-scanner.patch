diff --git a/src/lib/open/afterOpenModel.ts b/src/lib/open/afterOpenModel.ts
new file mode 100644
index 00000000..54112cbc
--- /dev/null
+++ b/src/lib/open/afterOpenModel.ts
@@ -0,0 +1,128 @@
+/**
+ * Pure model for the after-open view (OPEN-VIEW-1/-2): today's qualifying single-stock setups grouped by
+ * tape status, and a market strip. No fetching here; `afterOpenData.ts` supplies the inputs.
+ *
+ * Rows come from the Slate plan for the session (plan + also-qualify, stocks only). Each row carries its
+ * tape facts and status (`tapeFacts.ts`), R:R from the live price (`riskRewardFrom`, est.), and the
+ * suggested contract when one was read (PLAN-CONTRACT-RULE-1, est.). Group order is fixed: Confirming,
+ * Waiting, Not confirming, Range forming, No tape read, Invalidated. Inside a group the plan's own rule-based
+ * order is kept; the status never re-ranks names.
+ */
+
+import { riskRewardFrom, type MondayPlan, type PlanCandidate } from '@/lib/slate/mondayPlan';
+import type { PlanContractResult } from '@/lib/slate/planContract';
+import type { PlanPositioning } from '@/lib/slate/planPositioning';
+import { classifyTape, type TapeFacts, type TapeRead, type TapeStatus } from '@/lib/open/tapeFacts';
+
+export interface AfterOpenRow {
+  candidate: PlanCandidate;
+  inPlan: boolean;
+  facts: TapeFacts;
+  read: TapeRead;
+  /** est. R:R from the live price; null outside stop→target. */
+  rrLive: number | null;
+  contract: PlanContractResult | null;
+  /** ISO time of the live price, when read. */
+  priceAt: string | null;
+  /** Stored Ortex short positioning (ORTEX-SLATE-1); undefined when none is on file. */
+  positioning: PlanPositioning | undefined;
+}
+
+export interface AfterOpenGroup { status: TapeStatus; label: string; rows: AfterOpenRow[] }
+
+export interface StripItem {
+  symbol: string;
+  /** (last − prior close) ÷ prior close × 100. */
+  changePct: number | null;
+  /** Side of the vendor day VWAP. */
+  vsVwap: 'above' | 'below' | 'at' | null;
+}
+
+export interface AfterOpenModel {
+  sessionDate: string;
+  state: 'session' | 'not_session_day' | 'no_plan';
+  groups: AfterOpenGroup[];
+  counts: Record<TapeStatus, number>;
+  indices: StripItem[];
+  sectors: StripItem[];
+  vix: { value: number | null; changePct: number | null };
+  /** Vendor read failures worth saying on the page. */
+  notes: string[];
+}
+
+export const GROUP_ORDER: Array<{ status: TapeStatus; label: string }> = [
+  { status: 'confirming', label: 'Confirming' },
+  { status: 'waiting', label: 'Waiting' },
+  { status: 'not_confirming', label: 'Not confirming' },
+  { status: 'forming', label: 'Range forming' },
+  { status: 'unknown', label: 'No tape read' },
+  { status: 'invalidated', label: 'Invalidated' },
+];
+
+export const INDEX_SYMBOLS = ['SPY', 'QQQ', 'IWM'] as const;
+export const SECTOR_SYMBOLS = ['XLK', 'XLC', 'XLY', 'XLF', 'XLV', 'XLI', 'XLE', 'XLB', 'XLU', 'XLRE', 'XLP', 'SMH'] as const;
+
+export interface StripQuote { last: number; prevClose: number; vwap: number }
+
+export function stripItem(symbol: string, q: StripQuote | undefined): StripItem {
+  if (!q) return { symbol, changePct: null, vsVwap: null };
+  const changePct = Number.isFinite(q.prevClose) && q.prevClose > 0 ? ((q.last - q.prevClose) / q.prevClose) * 100 : null;
+  const vsVwap = Number.isFinite(q.vwap) && q.vwap > 0 ? (q.last > q.vwap ? 'above' : q.last < q.vwap ? 'below' : 'at') : null;
+  return { symbol, changePct, vsVwap };
+}
+
+export interface AfterOpenInputs {
+  plan: MondayPlan;
+  sessionDate: string;
+  isSessionDay: boolean;
+  facts: Map<string, TapeFacts>;
+  priceAt: Map<string, string>;
+  contracts: Record<string, PlanContractResult>;
+  positioning: Record<string, PlanPositioning>;
+  strip: Map<string, StripQuote>;
+  vix: { value: number | null; changePct: number | null };
+  notes: string[];
+}
+
+export function qualifyingStocks(plan: MondayPlan): Array<{ c: PlanCandidate; inPlan: boolean }> {
+  const seen = new Set<string>();
+  const out: Array<{ c: PlanCandidate; inPlan: boolean }> = [];
+  // One row per symbol: a name in both lists keeps its plan entry (plan first).
+  for (const [list, inPlan] of [[plan.plan, true], [plan.alsoQualify, false]] as const) {
+    for (const c of list) {
+      const sym = c.setup.symbol.toUpperCase();
+      if (c.kind !== 'stock' || seen.has(sym)) continue;
+      seen.add(sym);
+      out.push({ c, inPlan });
+    }
+  }
+  return out;
+}
+
+export function buildAfterOpenModel(i: AfterOpenInputs): AfterOpenModel {
+  const counts = Object.fromEntries(GROUP_ORDER.map(g => [g.status, 0])) as Record<TapeStatus, number>;
+  const base = {
+    sessionDate: i.sessionDate, counts, notes: i.notes, vix: i.vix,
+    indices: INDEX_SYMBOLS.map(s => stripItem(s, i.strip.get(s))),
+    sectors: SECTOR_SYMBOLS.map(s => stripItem(s, i.strip.get(s))),
+  };
+  if (!i.isSessionDay) return { ...base, state: 'not_session_day', groups: [] };
+  if (i.plan.source === 'unavailable') return { ...base, state: 'no_plan', groups: [] };
+  const rows: AfterOpenRow[] = qualifyingStocks(i.plan).flatMap(({ c, inPlan }) => {
+    const sym = c.setup.symbol.toUpperCase();
+    const facts = i.facts.get(sym);
+    if (!facts) return [];
+    const side = c.setup.direction === 'bearish' ? 'bearish' : 'bullish';
+    return [{
+      candidate: c, inPlan, facts,
+      read: c.setup.direction === 'unknown' ? { status: 'unknown' as const, reason: 'card has no direction' } : classifyTape(facts, side, c.setup.stop),
+      rrLive: riskRewardFrom(facts.last, c.setup),
+      contract: i.contracts[c.setup.id] ?? null,
+      priceAt: i.priceAt.get(sym) ?? null,
+      positioning: i.positioning[sym] ?? i.positioning[c.setup.symbol],
+    }];
+  });
+  for (const r of rows) counts[r.read.status] += 1;
+  const groups = GROUP_ORDER.map(g => ({ ...g, rows: rows.filter(r => r.read.status === g.status) })).filter(g => g.rows.length > 0);
+  return { ...base, state: 'session', groups };
+}
diff --git a/src/lib/open/tapeFacts.ts b/src/lib/open/tapeFacts.ts
new file mode 100644
index 00000000..223197fd
--- /dev/null
+++ b/src/lib/open/tapeFacts.ts
@@ -0,0 +1,162 @@
+/**
+ * After-open tape facts and status (owner decisions OPEN-VIEW-1, 2026-10-05, and OPEN-VIEW-2, 2026-10-06; plan
+ * docs/AFTER-OPEN-VIEW-PLAN-2026-10-05.md §3).
+ *
+ * Pure functions over vendor values: Polygon 1-minute bars for the session, the Polygon snapshot
+ * (last, open, prior close, day VWAP, day volume) and the last completed daily volumes. Nothing here
+ * fetches. Every derived value is a transparent calculation a reader can redo (Rule 3) and renders
+ * est. (Rule 1): gap %, % since the open, volume so far as a share of the 20-day average day. Percent fields are
+ * percentage points (0.99 means 0.99%); the volume share is a ratio (0.24 means 24% of an average day).
+ *
+ * Status rules (approved; bullish shown, bearish mirrored):
+ *   Confirming      last above the 30-minute opening-range high AND above VWAP
+ *   Waiting         inside the opening range AND at or above VWAP
+ *   Not confirming  inside the opening range AND below VWAP; also (OPEN-VIEW-2) above the range high while
+ *                   not above VWAP: VWAP decides a breakout
+ *   Invalidated     below the opening-range low, or at or through the stop; a stop hit is Invalidated at
+ *                   any time, before 10:00 ET included (OPEN-VIEW-2)
+ * Otherwise, before 10:00 ET the range is forming and no status is given. The status is display only: it
+ * never changes a gate, a level or the plan's rule-based order.
+ *
+ * Precedence: a stop hit (when a live price exists) → 'forming' before 10:00 ET → 'unknown' when inputs are
+ * missing (no live price/VWAP, no opening-range bars) → the table. 'unknown' is not a reading.
+ */
+
+import { etDateYmd, etMinutesOfDay } from '@/lib/marketSession';
+
+export const OPEN_MINUTE = 9 * 60 + 30;
+export const OPENING_RANGE_END_MINUTE = 10 * 60;
+export const PREMARKET_START_MINUTE = 4 * 60;
+export const VOLUME_BASELINE_SESSIONS = 20;
+
+export interface MinuteBar {
+  /** Bar start, epoch ms (Polygon `t`). */
+  t: number;
+  h: number;
+  l: number;
+  v: number;
+}
+
+export interface TapeSnapshot {
+  last: number;
+  open: number;
+  prevClose: number;
+  /** Day VWAP as the vendor reports it. */
+  vwap: number;
+  /** Day share volume so far. */
+  volume: number;
+}
+
+export interface TapeInputs {
+  /** ET session date, YYYY-MM-DD. */
+  sessionDate: string;
+  bars: MinuteBar[];
+  snapshot: TapeSnapshot | null;
+  /** Completed daily share volumes, oldest first. */
+  dailyVolumes: number[];
+  now: Date;
+}
+
+export interface Range { high: number; low: number }
+
+export interface TapeFacts {
+  sessionDate: string;
+  last: number | null;
+  vwap: number | null;
+  /** (open − prior close) ÷ prior close × 100. est. */
+  gapPct: number | null;
+  /** (last − open) ÷ open × 100. est. */
+  sinceOpenPct: number | null;
+  premarket: Range | null;
+  /** The 09:30-09:59 ET range; null until 10:00 ET or when no bar fell in the window. */
+  openingRange: Range | null;
+  openingRangeComplete: boolean;
+  /** Mean full-day volume of the last 20 completed sessions; null unless all 20 are present and positive. */
+  avgDailyVolume: number | null;
+  /** Day volume so far ÷ avgDailyVolume. est. Null while the vendor day volume is zero (before the open). */
+  volumeShare: number | null;
+}
+
+export type TapeSide = 'bullish' | 'bearish';
+export type TapeStatus = 'forming' | 'confirming' | 'waiting' | 'not_confirming' | 'invalidated' | 'unknown';
+
+export interface TapeRead {
+  status: TapeStatus;
+  reason: string;
+}
+
+const finite = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x);
+const pct = (a: number, b: number) => (b > 0 ? ((a - b) / b) * 100 : null);
+
+function rangeOf(bars: MinuteBar[]): Range | null {
+  if (bars.length === 0) return null;
+  let high = -Infinity, low = Infinity;
+  for (const b of bars) { high = Math.max(high, b.h); low = Math.min(low, b.l); }
+  return { high, low };
+}
+
+/** Bars of `sessionDate` whose start falls in [fromMinute, toMinute) ET. */
+export function barsBetween(bars: MinuteBar[], sessionDate: string, fromMinute: number, toMinute: number): MinuteBar[] {
+  return bars.filter(b => {
+    if (!finite(b.t) || !finite(b.h) || !finite(b.l)) return false;
+    const d = new Date(b.t);
+    if (etDateYmd(d) !== sessionDate) return false;
+    const m = etMinutesOfDay(d);
+    return m >= fromMinute && m < toMinute;
+  });
+}
+
+export function openingRangeComplete(sessionDate: string, now: Date): boolean {
+  const today = etDateYmd(now);
+  return today > sessionDate || (today === sessionDate && etMinutesOfDay(now) >= OPENING_RANGE_END_MINUTE);
+}
+
+export function computeTapeFacts(input: TapeInputs): TapeFacts {
+  const { sessionDate, bars, snapshot: s, dailyVolumes, now } = input;
+  const complete = openingRangeComplete(sessionDate, now);
+  const last = s && finite(s.last) ? s.last : null;
+  const open = s && finite(s.open) && s.open > 0 ? s.open : null;
+  const prevClose = s && finite(s.prevClose) && s.prevClose > 0 ? s.prevClose : null;
+  const vwap = s && finite(s.vwap) && s.vwap > 0 ? s.vwap : null;
+  const recent = dailyVolumes.slice(-VOLUME_BASELINE_SESSIONS);
+  const avg = recent.length === VOLUME_BASELINE_SESSIONS && recent.every(v => finite(v) && v > 0)
+    ? recent.reduce((a, b) => a + b, 0) / VOLUME_BASELINE_SESSIONS
+    : null;
+  return {
+    sessionDate,
+    last,
+    vwap,
+    gapPct: open !== null && prevClose !== null ? pct(open, prevClose) : null,
+    sinceOpenPct: last !== null && open !== null ? pct(last, open) : null,
+    premarket: rangeOf(barsBetween(bars, sessionDate, PREMARKET_START_MINUTE, OPEN_MINUTE)),
+    openingRange: complete ? rangeOf(barsBetween(bars, sessionDate, OPEN_MINUTE, OPENING_RANGE_END_MINUTE)) : null,
+    openingRangeComplete: complete,
+    avgDailyVolume: avg,
+    volumeShare: avg !== null && s && finite(s.volume) && s.volume > 0 ? s.volume / avg : null,
+  };
+}
+
+/** OPEN-VIEW-1/-2 status for one card. `stop` is the card's published stop (null when absent). */
+export function classifyTape(f: TapeFacts, side: TapeSide, stop: number | null): TapeRead {
+  const bull = side === 'bullish';
+  if (f.last !== null && stop !== null && finite(stop) && (bull ? f.last <= stop : f.last >= stop)) {
+    return { status: 'invalidated', reason: 'at or through the stop' };
+  }
+  if (!f.openingRangeComplete) return { status: 'forming', reason: 'opening range forming until 10:00 ET' };
+  if (f.last === null || f.vwap === null) return { status: 'unknown', reason: 'no live price or VWAP' };
+  if (f.openingRange === null) return { status: 'unknown', reason: 'no bars in the opening range' };
+  const { last, vwap } = f;
+  const { high, low } = f.openingRange;
+  if (bull ? last < low : last > high) {
+    return { status: 'invalidated', reason: bull ? 'below the opening-range low' : 'above the opening-range high' };
+  }
+  const right = bull ? last >= vwap : last <= vwap;
+  if (bull ? last > high : last < low) {
+    return right && last !== vwap
+      ? { status: 'confirming', reason: bull ? 'above the opening-range high and VWAP' : 'below the opening-range low and VWAP' }
+      : { status: 'not_confirming', reason: bull ? 'above the range but not above VWAP' : 'below the range but not below VWAP' };
+  }
+  return right
+    ? { status: 'waiting', reason: bull ? 'inside the range, at or above VWAP' : 'inside the range, at or below VWAP' }
+    : { status: 'not_confirming', reason: bull ? 'inside the range, below VWAP' : 'inside the range, above VWAP' };
+}
diff --git a/src/lib/open/tapeReader.ts b/src/lib/open/tapeReader.ts
new file mode 100644
index 00000000..8e267e46
--- /dev/null
+++ b/src/lib/open/tapeReader.ts
@@ -0,0 +1,153 @@
+/**
+ * Vendor reads behind the after-open view (OPEN-VIEW-1/-2; plan docs/AFTER-OPEN-VIEW-PLAN-2026-10-05.md).
+ *
+ * Three Polygon reads, all through `polygonFetch` (budget gate, circuit breaker, throttle):
+ *   - the stocks snapshot: live price (same rule as the Slate's live read: last trade, else the latest
+ *     1-minute bar), day open, day VWAP, day volume and prior close. A missing vendor field stays missing
+ *     (NaN → null downstream); nothing is filled from another field.
+ *   - 1-minute aggregates for the session date (pre-market included) for the opening and pre-market ranges.
+ *   - daily aggregates before the session date for the 20-day volume baseline.
+ * Short in-memory caches keep a page refresh from re-reading the same bars: minute bars 60 s, daily volumes
+ * for the session date. Nothing is written anywhere.
+ */
+
+import { polygonFetch } from '@/services/polygonService';
+import { parseSnapshotQuotes } from '@/lib/slate/planLive';
+import { addCalendarDays } from '@/lib/slate/planContract';
+import type { MinuteBar, TapeSnapshot } from '@/lib/open/tapeFacts';
+
+const SYMBOL_RE = /^[A-Z0-9]+(?:[.-][A-Z0-9]+)*$/;
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+const SNAPSHOT_BATCH = 100;
+const MINUTE_TTL_MS = 60_000;
+/** Calendar days of daily bars requested to be sure of 20 completed sessions. */
+const DAILY_LOOKBACK_DAYS = 45;
+
+export interface TapeQuote extends TapeSnapshot {
+  symbol: string;
+  /** ISO time of the live price. */
+  at: string;
+}
+
+type Fetcher = typeof polygonFetch;
+
+const num = (x: unknown) => (typeof x === 'number' && Number.isFinite(x) ? x : Number.NaN);
+
+/** Pure: the snapshot payload → per-symbol tape quote. A row without a live price is skipped. */
+export function parseTapeSnapshots(payload: unknown): Map<string, TapeQuote> {
+  const out = new Map<string, TapeQuote>();
+  const quotes = parseSnapshotQuotes(payload);
+  const tickers = (payload as { tickers?: unknown })?.tickers;
+  if (!Array.isArray(tickers)) return out;
+  for (const t of tickers) {
+    const row = t as { ticker?: unknown; day?: { o?: unknown; vw?: unknown; v?: unknown }; prevDay?: { c?: unknown } };
+    const symbol = typeof row.ticker === 'string' ? row.ticker.toUpperCase() : '';
+    const q = quotes.get(symbol);
+    if (!q) continue;
+    out.set(symbol, {
+      symbol, last: q.price, at: q.at,
+      open: num(row.day?.o), vwap: num(row.day?.vw), volume: num(row.day?.v), prevClose: num(row.prevDay?.c),
+    });
+  }
+  return out;
+}
+
+export interface TapeSnapshotRead {
+  quotes: Map<string, TapeQuote>;
+  /** Symbols whose snapshot batch failed (vendor error), so they have no reading at all. */
+  failed: string[];
+}
+
+/** Batched snapshot reads; a failed batch is reported by symbol, never dropped silently. */
+export async function readTapeSnapshots(symbols: string[], fetcher: Fetcher = polygonFetch): Promise<TapeSnapshotRead> {
+  const list = Array.from(new Set(symbols.map(s => s.toUpperCase()).filter(s => SYMBOL_RE.test(s))));
+  const quotes = new Map<string, TapeQuote>();
+  const failed: string[] = [];
+  if (list.length === 0) return { quotes, failed };
+  const batches: string[][] = [];
+  for (let i = 0; i < list.length; i += SNAPSHOT_BATCH) batches.push(list.slice(i, i + SNAPSHOT_BATCH));
+  const settled = await Promise.allSettled(batches.map(b => fetcher<unknown>('/v2/snapshot/locale/us/markets/stocks/tickers', { tickers: b.join(',') })));
+  settled.forEach((r, i) => {
+    if (r.status === 'fulfilled') for (const [k, v] of parseTapeSnapshots(r.value)) quotes.set(k, v);
+    else failed.push(...batches[i]);
+  });
+  return { quotes, failed };
+}
+
+/** Pure: Polygon aggregates `results` → minute bars (finite high/low/time only). */
+export function parseMinuteBars(payload: unknown): MinuteBar[] {
+  const rows = (payload as { results?: unknown })?.results;
+  if (!Array.isArray(rows)) return [];
+  const out: MinuteBar[] = [];
+  for (const r of rows) {
+    const b = r as { t?: unknown; h?: unknown; l?: unknown; v?: unknown };
+    const t = num(b.t), h = num(b.h), l = num(b.l), v = num(b.v);
+    if (Number.isFinite(t) && Number.isFinite(h) && Number.isFinite(l)) out.push({ t, h, l, v: Number.isFinite(v) ? v : 0 });
+  }
+  return out;
+}
+
+/** UTC date of a Polygon daily bar: bars are stamped at midnight ET, so read the date of t + 12 h. */
+export const dailyBarDate = (t: number) => new Date(t + 12 * 3_600_000).toISOString().slice(0, 10);
+
+/** Pure: daily aggregates → full-day volumes of sessions strictly before `sessionDate`, oldest first. */
+export function parseDailyVolumes(payload: unknown, sessionDate: string): number[] {
+  const rows = (payload as { results?: unknown })?.results;
+  if (!Array.isArray(rows)) return [];
+  return rows
+    .map(r => r as { t?: unknown; v?: unknown })
+    .filter(r => Number.isFinite(num(r.t)) && dailyBarDate(num(r.t)) < sessionDate)
+    .sort((a, b) => num(a.t) - num(b.t))
+    .map(r => num(r.v));
+}
+
+const minuteCache = new Map<string, { at: number; bars: MinuteBar[] }>();
+const dailyCache = new Map<string, number[]>();
+/** Bound on cached keys; on overflow, expired minute entries and other session dates are dropped first. */
+const CACHE_MAX_KEYS = 500;
+
+function prune(nowMs: number, sessionDate: string): void {
+  if (minuteCache.size > CACHE_MAX_KEYS) {
+    for (const [k, v] of minuteCache) if (nowMs - v.at >= MINUTE_TTL_MS || !k.endsWith(`:${sessionDate}`)) minuteCache.delete(k);
+    while (minuteCache.size > CACHE_MAX_KEYS) minuteCache.delete(minuteCache.keys().next().value as string);
+  }
+  if (dailyCache.size > CACHE_MAX_KEYS) {
+    for (const k of dailyCache.keys()) if (!k.endsWith(`:${sessionDate}`)) dailyCache.delete(k);
+    while (dailyCache.size > CACHE_MAX_KEYS) dailyCache.delete(dailyCache.keys().next().value as string);
+  }
+}
+
+export async function readMinuteBars(symbol: string, sessionDate: string, fetcher: Fetcher = polygonFetch, nowMs = Date.now()): Promise<MinuteBar[]> {
+  if (!SYMBOL_RE.test(symbol) || !DATE_RE.test(sessionDate)) return [];
+  const key = `${symbol}:${sessionDate}`;
+  const hit = minuteCache.get(key);
+  if (hit && nowMs - hit.at < MINUTE_TTL_MS) return hit.bars;
+  const bars = parseMinuteBars(await fetcher<unknown>(`/v2/aggs/ticker/${symbol}/range/1/minute/${sessionDate}/${sessionDate}`, { adjusted: 'true', sort: 'asc', limit: '50000' }));
+  minuteCache.set(key, { at: nowMs, bars });
+  prune(nowMs, sessionDate);
+  return bars;
+}
+
+export async function readDailyVolumes(symbol: string, sessionDate: string, fetcher: Fetcher = polygonFetch): Promise<number[]> {
+  if (!SYMBOL_RE.test(symbol) || !DATE_RE.test(sessionDate)) return [];
+  const key = `${symbol}:${sessionDate}`;
+  const hit = dailyCache.get(key);
+  if (hit !== undefined) return hit;
+  const from = addCalendarDays(sessionDate, -DAILY_LOOKBACK_DAYS);
+  const to = addCalendarDays(sessionDate, -1);
+  const vols = parseDailyVolumes(await fetcher<unknown>(`/v2/aggs/ticker/${symbol}/range/1/day/${from}/${to}`, { adjusted: 'true', sort: 'asc', limit: '100' }), sessionDate);
+  dailyCache.set(key, vols);
+  prune(Date.now(), sessionDate);
+  return vols;
+}
+
+/** Test seam: cached key counts. */
+export function tapeCacheSizes(): { minute: number; daily: number } {
+  return { minute: minuteCache.size, daily: dailyCache.size };
+}
+
+/** Test seam: drop the in-memory caches. */
+export function resetTapeCaches(): void {
+  minuteCache.clear();
+  dailyCache.clear();
+}
diff --git a/src/lib/sip/__tests__/calculation.test.ts b/src/lib/sip/__tests__/calculation.test.ts
new file mode 100644
index 00000000..220e48e7
--- /dev/null
+++ b/src/lib/sip/__tests__/calculation.test.ts
@@ -0,0 +1,186 @@
+import { describe, expect, it } from "vitest";
+import { clock, previousSessions, sessionTime } from "../calendar";
+import {
+  dailyEligibility,
+  preparationFromBars,
+  openingVolume,
+  rankCandidates,
+  stockUniverse,
+} from "../calculation";
+import type { SipBar } from "../contract";
+
+const date = "2026-10-06";
+function daily(): SipBar[] {
+  return previousSessions(date, 40)
+    .reverse()
+    .map((day) => ({
+      t: sessionTime(day, 0).getTime(),
+      o: 10,
+      h: 10.5,
+      l: 9.5,
+      c: 10,
+      v: 1_000_000,
+    }));
+}
+function opening(day: string, volume = 100): SipBar[] {
+  return Array.from({ length: 5 }, (_, i) => ({
+    t: sessionTime(day, 570 + i).getTime(),
+    o: 10,
+    h: 11,
+    l: 9,
+    c: 10,
+    v: volume,
+  }));
+}
+function history(): SipBar[] {
+  return previousSessions(date, 14).flatMap((day) => opening(day));
+}
+
+describe("SIP completed opening-volume calculation", () => {
+  it("compares the same five minutes across exactly fourteen previous sessions", () => {
+    expect(preparationFromBars("NVDA", date, daily(), history())).toMatchObject(
+      { symbol: "NVDA", atr14: 1, avg_vol: 1_000_000, opening_mean: 500 },
+    );
+    expect(openingVolume(opening(date, 200), date)).toBe(1000);
+  });
+  it("excludes today from daily ATR and average share volume", () => {
+    const extra = {
+      ...daily()[0],
+      t: sessionTime(date, 0).getTime(),
+      h: 100,
+      v: 50_000_000,
+    };
+    expect(dailyEligibility(date, [...daily(), extra])).toMatchObject({
+      atr14: 1,
+      avg_vol: 1_000_000,
+    });
+  });
+  it("rejects incomplete historical opening windows instead of inventing volume", () => {
+    expect(() =>
+      preparationFromBars("NVDA", date, daily(), history().slice(1)),
+    ).toThrow("OPENING_WINDOW_INCOMPLETE");
+  });
+  it("retains the malformed historical opening-window exclusion code", () => {
+    const invalid = history();
+    invalid[0] = { ...invalid[0], c: invalid[0].h + 1 };
+    expect(() => preparationFromBars("NVDA", date, daily(), invalid)).toThrow(
+      "OPENING_WINDOW_INVALID",
+    );
+  });
+  it("retains the duplicate historical opening-window exclusion code", () => {
+    const original = history();
+    expect(() =>
+      preparationFromBars("NVDA", date, daily(), [...original, original[0]]),
+    ).toThrow("OPENING_WINDOW_INVALID");
+  });
+  it("rejects duplicated bars and nonfinite volume", () => {
+    expect(() =>
+      openingVolume([...opening(date), opening(date)[0]], date),
+    ).toThrow("OPENING_WINDOW_INVALID");
+    expect(() =>
+      openingVolume(
+        opening(date).map((b, i) => (i ? b : { ...b, v: NaN })),
+        date,
+      ),
+    ).toThrow("OPENING_WINDOW_INVALID");
+  });
+  it("ignores premarket and the still-forming 09:35 bar", () => {
+    const extras = [569, 575].map((m) => ({
+      ...opening(date)[0],
+      t: sessionTime(date, m).getTime(),
+      v: 999_999,
+    }));
+    expect(openingVolume([...extras, ...opening(date)], date)).toBe(500);
+  });
+  it("requires enough completed history and keeps the exact liquidity/ATR boundaries", () => {
+    expect(() => dailyEligibility(date, daily().slice(0, 19))).toThrow(
+      "DAILY_HISTORY_INCOMPLETE",
+    );
+    expect(() =>
+      dailyEligibility(
+        date,
+        daily().map((b) => ({ ...b, v: 999_999 })),
+      ),
+    ).toThrow("DAILY_LIQUIDITY");
+    expect(() =>
+      dailyEligibility(
+        date,
+        daily().map((b) => ({ ...b, h: 10.25, l: 9.75 })),
+      ),
+    ).toThrow("ATR_TOO_LOW");
+  });
+  it("does not permit a zero baseline denominator", () => {
+    expect(() =>
+      preparationFromBars(
+        "NVDA",
+        date,
+        daily(),
+        history().map((b) => ({ ...b, v: 0 })),
+      ),
+    ).toThrow("OPENING_BASELINE_ZERO");
+  });
+  it("ranks at most twenty, price strictly above five, by RVOL then symbol", () => {
+    const row = { price: 10, rvol: 2, atr14: 1, avg_vol: 1_000_000 };
+    const rows = [
+      ...Array.from({ length: 25 }, (_, i) => ({
+        ...row,
+        symbol: "S" + String(i).padStart(2, "0"),
+      })),
+      { ...row, symbol: "FIVE", price: 5 },
+      { ...row, symbol: "BAD", rvol: Infinity },
+    ];
+    const ranked = rankCandidates(rows);
+    expect(ranked).toHaveLength(20);
+    expect(ranked[0].symbol).toBe("S00");
+    expect(ranked.some((r) => r.symbol === "FIVE" || r.symbol === "BAD")).toBe(
+      false,
+    );
+  });
+  it("uses verified stock classification and excludes ETFs and unknowns", () => {
+    expect(
+      stockUniverse(["NVDA", "SPY", "QQQ", "UNKNOWN"], {
+        NVDA: "Technology",
+        SPY: "ETF/Fund",
+        QQQ: "ETF/Fund",
+      }),
+    ).toEqual(["NVDA"]);
+  });
+});
+describe("Eastern exchange calendar", () => {
+  it("skips the July 3 exchange closure and weekend", () =>
+    expect(previousSessions("2026-07-06", 1)).toEqual(["2026-07-02"]));
+  it("handles DST without changing the opening-window identity", () => {
+    expect(sessionTime("2026-10-06", 575).toISOString()).toBe(
+      "2026-10-06T13:35:00.000Z",
+    );
+    expect(sessionTime("2026-11-09", 575).toISOString()).toBe(
+      "2026-11-09T14:35:00.000Z",
+    );
+    expect(clock(sessionTime("2026-11-09", 575))).toMatchObject({
+      date: "2026-11-09",
+      minute: 575,
+      trading: true,
+    });
+  });
+});
+
+it("rejects impossible open/close values in daily and opening candles", () => {
+  expect(() =>
+    dailyEligibility(
+      date,
+      daily().map((b) => ({ ...b, o: 100, c: 100 })),
+    ),
+  ).toThrow("DAILY_HISTORY_INCOMPLETE");
+  expect(() =>
+    openingVolume(
+      opening(date).map((b) => ({ ...b, c: 100 })),
+      date,
+    ),
+  ).toThrow("OPENING_WINDOW_INVALID");
+});
+it("fails closed for unsupported calendar years and history boundaries", () => {
+  expect(clock(sessionTime("2028-11-23", 575)).trading).toBe(false);
+  expect(() => previousSessions("2026-01-05", 14)).toThrow(
+    "CALENDAR_UNSUPPORTED",
+  );
+});
