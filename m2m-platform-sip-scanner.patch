+  it('uses verified stock classification and excludes ETFs and unknowns', () => {
+    expect(stockUniverse(['NVDA','SPY','QQQ','UNKNOWN'],{NVDA:'Technology',SPY:'ETF/Fund',QQQ:'ETF/Fund'})).toEqual(['NVDA']);
+  });
+});
