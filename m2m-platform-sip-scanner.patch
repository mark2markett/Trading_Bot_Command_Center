+
+const NOW = new Date('2026-10-05T16:57:00.000Z');
+const cand = (symbol: string, direction: 'bullish' | 'bearish', stop: number, target: number): PlanCandidate => ({
+  setup: { id: `id-${symbol}`, symbol, direction, strategy: 'test', quality: 0, factors: 0, visibility: 'live', entryPrice: null, stop, target, catalystText: null, structure: '', sessionDate: '2026-10-02', entryPriceSource: null, stopLossSource: null },
+  kind: 'stock', enrich: null, notEvaluated: false, checks: [], rr: null, rrNow: null, fails: 0, unknowns: 0, rankUnknowns: 0,
+});
+const facts = (last: number, vwap: number, high: number, low: number): TapeFacts => ({
+  sessionDate: '2026-10-05', last, vwap, gapPct: -0.34, sinceOpenPct: 0.99, premarket: { high: 161.5, low: 161.5 },
