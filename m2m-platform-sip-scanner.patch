--- /dev/null
+++ b/src/lib/sip/__tests__/service.test.ts
@@ -0,0 +1,219 @@
+import { describe, it, expect, vi } from "vitest";
+import readyFixture from "../../../../tests/fixtures/sip/sip-v1-ready.json";
+import { SipScanner, phaseAt } from "../service";
+import { machineResponse } from "../http";
+import { previousSessions, sessionTime } from "../calendar";
+import { SipUnavailable } from "../contract";
+const date = "2026-10-06",
+  now = sessionTime(date, 575);
+const daily = previousSessions(date, 40)
+  .reverse()
+  .map((d) => ({
+    t: sessionTime(d, 0).getTime(),
+    o: 10,
+    h: 10.5,
+    l: 9.5,
+    c: 10,
+    v: 1e6,
+  }));
+const bars = (d: string, v = 100) =>
+  Array.from({ length: 5 }, (_, i) => ({
+    t: sessionTime(d, 570 + i).getTime(),
+    o: 10,
+    h: 11,
+    l: 9,
+    c: 10,
+    v,
+  }));
+function fixture() {
+  const values = new Map<string, any>();
+  const store = {
+    result: vi.fn(async (d) => values.get(d + ":result") ?? null),
+    preparation: vi.fn(async (d) => values.get(d + ":prep") ?? null),
+    symbol: vi.fn(async (d, s) => values.get(d + ":" + s) ?? null),
+    saveSymbol: vi.fn(async (d, s, v) => {
+      values.set(d + ":" + s, v);
+    }),
+    savePreparation: vi.fn(async (d, v) => {
+      values.set(d + ":prep", v);
+    }),
+    saveResult: vi.fn(async (d, v) => {
+      if (!values.has(d + ":result")) values.set(d + ":result", v);
+    }),
+    withLock: vi.fn(async (d, fn) => fn("owner")),
+  };
+  const data = {
+    dailyBars: vi.fn(async () => daily),
+    historyMinutes: vi.fn(async () =>
+      previousSessions(date, 14).flatMap((d) => bars(d)),
+    ),
+    openingMinutes: vi.fn(async () => bars(date, 200)),
+    quotes: vi.fn(async (symbols) =>
+      Object.fromEntries(
+        symbols.map((s) => [s, { price: 10, at: now.getTime() }]),
+      ),
+    ),
+  };
+  const scanner = new SipScanner(data, store, ["NVDA", "AMD"], () => now);
+  return { data, store, scanner, values };
+}
+describe("preparation, completeness and publication", () => {
+  it.each([
+    ["missing version", { ...readyFixture, version: undefined }],
+    ["wrong session", { ...readyFixture, session_date: "2026-10-05" }],
+    ["contradictory coverage", { ...readyFixture, candidates: [] }],
+  ])("rejects a cached snapshot with %s without refreshing or overwriting it", async (_case, stored) => {
+    const f = fixture();
+    f.values.set(date + ":result", stored);
+    await expect(f.scanner.publish(now)).rejects.toThrow("SIP_SNAPSHOT_INVALID");
+    expect(f.store.saveResult).not.toHaveBeenCalled();
+    expect(f.store.preparation).not.toHaveBeenCalled();
+    expect(f.data.openingMinutes).not.toHaveBeenCalled();
+    expect(f.data.quotes).not.toHaveBeenCalled();
+    expect(f.values.get(date + ":result")).toEqual(stored);
+  });
+  it("reuses a valid cached empty snapshot without data requests", async () => {
+    const f = fixture();
+    const stored = { ...readyFixture, candidates: [], coverage: { universe: 0, eligible: 0, observed: 0, excluded: 0 } };
+    f.values.set(date + ":result", stored);
+    expect(await f.scanner.publish(now)).toEqual(stored);
+    expect(f.store.saveResult).not.toHaveBeenCalled();
+    expect(f.data.openingMinutes).not.toHaveBeenCalled();
+    expect(f.data.quotes).not.toHaveBeenCalled();
+  });
+  it("prepares the universe then publishes precise RVOL and immutable result", async () => {
+    const { scanner, store, data } = fixture();
+    expect((await scanner.prepare(now))?.complete).toBe(true);
+    const result = await scanner.publish(now);
+    expect(result).toEqual(readyFixture);
+    expect(result?.candidates.map((c) => c.symbol)).toEqual(["AMD", "NVDA"]);
+    expect(result?.candidates[0].rvol).toBe(2);
+    expect(result?.coverage).toEqual({
+      universe: 2,
+      eligible: 2,
+      observed: 2,
+      excluded: 0,
+    });
+    await scanner.publish(now);
+    expect(store.saveResult).toHaveBeenCalledTimes(1);
+    expect(data.openingMinutes).toHaveBeenCalledTimes(2);
+  });
+  it("retains successful preparation but never publishes through transport failures", async () => {
+    const f = fixture();
+    f.data.dailyBars.mockRejectedValueOnce(
+      new SipUnavailable("SCHWAB_HTTP_500"),
+    );
+    expect((await f.scanner.prepare(now))?.complete).toBe(false);
+    await expect(f.scanner.publish(now)).rejects.toThrow(
+      "PREPARATION_INCOMPLETE",
+    );
+    await f.scanner.prepare(now);
+    expect(f.data.dailyBars).toHaveBeenCalledTimes(3);
+  });
+  it("records history exclusions without inventing zero-volume observations", async () => {
+    const f = fixture();
+    f.data.historyMinutes.mockResolvedValue([]);
+    await f.scanner.prepare(now);
+    const r = await f.scanner.publish(now);
+    expect(r?.candidates).toEqual([]);
+    expect(r?.exclusions).toHaveLength(2);
+    expect(f.data.openingMinutes).not.toHaveBeenCalled();
+  });
+  it("retries incomplete current bars and preserves already completed observations", async () => {
+    const f = fixture();
+    await f.scanner.prepare(now);
+    f.data.openingMinutes.mockResolvedValueOnce(bars(date).slice(1));
+    await expect(f.scanner.publish(now)).rejects.toThrow(
+      "OPENING_WINDOW_INCOMPLETE",
+    );
+    expect(f.store.saveResult).not.toHaveBeenCalled();
+    await f.scanner.publish(now);
+    expect(f.data.openingMinutes).toHaveBeenCalledTimes(3);
+  });
+  it("refuses stale quotes and before-window publication", async () => {
+    const f = fixture();
+    await f.scanner.prepare(now);
+    await expect(f.scanner.publish(sessionTime(date, 574))).rejects.toThrow(
+      "OUTSIDE_PUBLISH_WINDOW",
+    );
+    f.data.quotes.mockResolvedValue({
+      NVDA: { price: 10, at: now.getTime() - 121000 },
+      AMD: { price: 10, at: now.getTime() },
+    });
+    await expect(f.scanner.publish(now)).rejects.toThrow("SCHWAB_QUOTE_STALE");
+  });
+});
+describe("machine auth and schedules", () => {
+  it("guards Eastern windows, DST and holidays", () => {
+    expect(phaseAt(sessionTime(date, 540))).toBe("prepare");
+    expect(phaseAt(sessionTime(date, 575))).toBe("publish");
+    expect(phaseAt(sessionTime(date, 580))).toBe(null);
+    expect(phaseAt(new Date("2026-11-09T14:35:00Z"))).toBe("publish");
+    expect(phaseAt(sessionTime("2026-11-26", 575))).toBe(null);
+  });
+  const secret = "s".repeat(32);
+  const env = {
+    enabled: "true",
+    secret,
+    reserved: { CRON_SECRET: "c".repeat(32) },
+  };
+  it("hides disabled and denies unauthenticated or shared credentials without storage calls", async () => {
+    const read = vi.fn();
+    expect(
+      (
+        await machineResponse(
+          new Request("https://test"),
+          { ...env, enabled: "false" },
+          read,
+          now,
+        )
+      ).status,
+    ).toBe(404);
+    expect(
+      (await machineResponse(new Request("https://test"), env, read, now))
+        .status,
+    ).toBe(401);
+    expect(
+      (
+        await machineResponse(
+          new Request("https://test", {
+            headers: { authorization: `Bearer ${secret}` },
+          }),
+          { ...env, reserved: { CRON_SECRET: secret } },
+          read,
+          now,
+        )
+      ).status,
+    ).toBe(503);
+    expect(read).not.toHaveBeenCalled();
+  });
+  it("returns pending then authenticated empty-ready from storage alone with no-store", async () => {
+    const req = new Request("https://test", {
+      headers: { authorization: `Bearer ${secret}` },
+    });
+    const read = vi
+      .fn()
+      .mockResolvedValueOnce(null)
+      .mockResolvedValueOnce({ ...readyFixture, candidates: [], coverage: { universe: 0, eligible: 0, observed: 0, excluded: 0 } });
+    const pending = await machineResponse(req, env, read, now);
+    expect(pending.status).toBe(202);
+    const ready = await machineResponse(req, env, read, now);
+    expect(ready.status).toBe(200);
+    expect(ready.headers.get("Cache-Control")).toContain("no-store");
+    expect(read).toHaveBeenCalledWith(date);
+  });
+  it("does not leak storage failures", async () => {
+    const response = await machineResponse(
+      new Request("https://test", {
+        headers: { authorization: `Bearer ${secret}` },
+      }),
+      env,
+      async () => {
+        throw new Error("private");
+      },
+      now,
+    );
+    expect(response.status).toBe(503);
+    expect(await response.text()).not.toContain("private");
+  });
+});
diff --git a/src/lib/sip/calculation.ts b/src/lib/sip/calculation.ts
new file mode 100644
index 00000000..8d6d1fcc
--- /dev/null
+++ b/src/lib/sip/calculation.ts
@@ -0,0 +1,123 @@
+import { clock, previousSessions, sessionTime } from "./calendar";
+import {
+  SipExcluded,
+  type PreparationRow,
+  type SipBar,
+  type SipCandidate,
+} from "./contract";
+
+function validBar(bar: SipBar): boolean {
+  return (
+    [bar.t, bar.o, bar.h, bar.l, bar.c, bar.v].every(Number.isFinite) &&
+    bar.o > 0 &&
+    bar.c > 0 &&
+    bar.l > 0 &&
+    bar.h >= Math.max(bar.o, bar.c) &&
+    bar.l <= Math.min(bar.o, bar.c) &&
+    bar.v >= 0
+  );
+}
+// Recognized stock sectors in config/universeSectors.ts (FMP/Yahoo taxonomy).
+// A new/unknown label must be reviewed before it can admit scanner symbols.
+const STOCK_SECTORS = new Set([
+  "Basic Materials", "Communication Services", "Consumer Cyclical", "Consumer Defensive",
+  "Energy", "Financial Services", "Healthcare", "Industrials", "Real Estate", "Technology", "Utilities",
+]);
+export function stockUniverse(
+  symbols: string[],
+  sectors: Record<string, string>,
+): string[] {
+  return [...new Set(symbols)]
+    .filter((s) => STOCK_SECTORS.has(sectors[s]))
+    .sort();
+}
+export function dailyEligibility(
+  date: string,
+  bars: SipBar[],
+): { atr14: number; avg_vol: number } {
+  const completed = bars
+    .filter((b) => Number.isFinite(b.t) && clock(new Date(b.t)).date < date)
+    .sort((a, b) => a.t - b.t);
+  const days = completed.map((b) => clock(new Date(b.t)).date);
+  const needed = previousSessions(date, 20).reverse();
+  if (
+    completed.length < 20 ||
+    completed.some((b) => !validBar(b)) ||
+    new Set(days).size !== days.length ||
+    needed.some((day, i) => days.slice(-20)[i] !== day)
+  )
+    throw new SipExcluded("DAILY_HISTORY_INCOMPLETE");
+  const avg_vol = completed.slice(-20).reduce((s, b) => s + b.v, 0) / 20;
+  const ranges = completed
+    .slice(1)
+    .map((b, i) =>
+      Math.max(
+        b.h - b.l,
+        Math.abs(b.h - completed[i].c),
+        Math.abs(b.l - completed[i].c),
+      ),
+    );
+  let atr14 = ranges.slice(0, 14).reduce((s, n) => s + n, 0) / 14;
+  for (const range of ranges.slice(14)) atr14 = (atr14 * 13 + range) / 14;
+  if (avg_vol < 1_000_000) throw new SipExcluded("DAILY_LIQUIDITY");
+  if (!(atr14 > 0.5)) throw new SipExcluded("ATR_TOO_LOW");
+  return { atr14, avg_vol };
+}
+export function openingVolume(bars: SipBar[], date: string): number {
+  const start = sessionTime(date, 570).getTime(),
+    end = sessionTime(date, 575).getTime();
+  const window = bars
+    .filter((b) => b.t >= start && b.t < end)
+    .sort((a, b) => a.t - b.t);
+  if (window.length !== 5)
+    throw new SipExcluded(
+      window.length > 5
+        ? "OPENING_WINDOW_INVALID"
+        : "OPENING_WINDOW_INCOMPLETE",
+    );
+  if (window.some((b, i) => !validBar(b) || b.t !== start + i * 60_000))
+    throw new SipExcluded("OPENING_WINDOW_INVALID");
+  return window.reduce((s, b) => s + b.v, 0);
+}
+export function preparationFromBars(
+  symbol: string,
+  date: string,
+  daily: SipBar[],
+  minute: SipBar[],
+): PreparationRow {
+  return preparationFromEligibility(symbol, date, dailyEligibility(date, daily), minute);
+}
+// Only pass the result of dailyEligibility; this keeps the pre-history filter
+// in the service without recalculating its completed daily series.
+export function preparationFromEligibility(
+  symbol: string,
+  date: string,
+  eligibility: ReturnType<typeof dailyEligibility>,
+  minute: SipBar[],
+): PreparationRow {
+  let observations: number[];
+  try {
+    observations = previousSessions(date, 14).map((day) =>
+      openingVolume(minute, day),
+    );
+  } catch (error) {
+    if (error instanceof SipExcluded) throw error;
+    throw new SipExcluded("OPENING_HISTORY_INCOMPLETE");
+  }
+  const opening_mean = observations.reduce((s, n) => s + n, 0) / 14;
+  if (!(opening_mean > 0)) throw new SipExcluded("OPENING_BASELINE_ZERO");
+  return { symbol, ...eligibility, opening_mean };
+}
+export function rankCandidates(rows: SipCandidate[]): SipCandidate[] {
+  return rows
+    .filter(
+      (r) =>
+        [r.price, r.rvol, r.atr14, r.avg_vol].every(Number.isFinite) &&
+        r.price > 5 &&
+        r.rvol >= 0 &&
+        r.atr14 > 0.5 &&
+        r.avg_vol >= 1_000_000,
+    )
+    .sort((a, b) => b.rvol - a.rvol || a.symbol.localeCompare(b.symbol))
+    .slice(0, 20);
+}
diff --git a/src/lib/sip/calendar.ts b/src/lib/sip/calendar.ts
new file mode 100644
index 00000000..1e0f9fe5
--- /dev/null
+++ b/src/lib/sip/calendar.ts
@@ -0,0 +1,41 @@
+import { SipUnavailable } from "./contract";
+import { isTradingDay } from "@/lib/trading-day";
+
+const formatter = new Intl.DateTimeFormat("en-US", {
+  timeZone: "America/New_York",
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  hourCycle: "h23",
+});
+export function clock(now: Date) {
+  const p = Object.fromEntries(
+    formatter.formatToParts(now).map((p) => [p.type, p.value]),
+  );
+  const date = `${p.year}-${p.month}-${p.day}`;
+  return {
+    date,
+    minute: Number(p.hour) * 60 + Number(p.minute),
+    trading: ["2026", "2027"].includes(p.year) && isTradingDay(date),
+  };
+}
+export function sessionTime(date: string, minute: number): Date {
+  const noonUtc = new Date(`${date}T12:00:00Z`);
+  return new Date(
+    noonUtc.getTime() + (minute - clock(noonUtc).minute) * 60_000,
+  );
+}
+export function previousSessions(date: string, count: number): string[] {
+  const result: string[] = [];
+  const cursor = new Date(`${date}T12:00:00Z`);
+  while (result.length < count) {
+    cursor.setUTCDate(cursor.getUTCDate() - 1);
+    const day = cursor.toISOString().slice(0, 10);
+    if (![2026, 2027].includes(cursor.getUTCFullYear()))
+      throw new SipUnavailable("CALENDAR_UNSUPPORTED");
+    if (isTradingDay(day)) result.push(day);
+  }
+  return result;
+}
