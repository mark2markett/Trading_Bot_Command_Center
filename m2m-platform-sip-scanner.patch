+import { describe, expect, it, vi } from 'vitest';
+import { fromHistory, fromSnapshot, readPlanPositioning, relChangePct } from '@/lib/slate/planPositioning';
+
+const snap = (symbol: string, over: Record<string, unknown> = {}) => ({
+  symbol, source_date: '2026-09-30', si_shares: '10000000', si_pct_free_float: '12.4000', days_to_cover: '3.1000', cost_to_borrow_all: '0.5600', short_availability_shares: '42000000', short_availability_pct: '1433.4617', ...over,
+});
+const historyRows = (vals: number[]) => vals.map((v, i) => ({ date: `2026-09-${String(10 + i).padStart(2, '0')}`, shortInterestPcFreeFloat: v, shortInterestShares: v * 1e6 }));
+
+describe('plan positioning (cache-only Ortex read, ORTEX-SLATE-1)', () => {
+  it('relative change needs a positive prior value', () => {
+    expect(relChangePct(12, 10)).toBeCloseTo(20);
+    expect(relChangePct(12, 0)).toBeNull();
+    expect(relChangePct(null, 10)).toBeNull();
+  });
+
+  it('a bulk row maps vendor values plain, derives available ÷ short from share counts, and reads only the 9999 sentinel from the unverified pct field', () => {
+    const p = fromSnapshot(snap('AAA'), { symbol: 'AAA', si_pct_free_float: '10' }, '2026-09-23');
+    expect(p).toMatchObject({ source: 'bulk', asOf: '2026-09-30', siPctFreeFloat: 12.4, daysToCover: 3.1, costToBorrowPct: 0.56, availVsShort: 4.2, availabilityUnlimited: false, priorAsOf: '2026-09-23' });
+    expect(p.siChangePct).toBeCloseTo(24);
+    const u = fromSnapshot(snap('BBB', { short_availability_pct: '9999' }), undefined, '2026-09-23');
+    expect(u).toMatchObject({ availabilityUnlimited: true, availVsShort: null, siChangePct: null, priorAsOf: null });
+    expect(fromSnapshot(snap('CCC', { si_shares: '0' }), undefined, null).availVsShort).toBeNull();
+  });
+
+  it('a per-name history gives short interest only, compared five rows back', () => {
+    const p = fromHistory('VSH', historyRows([10, 10, 11, 11, 12, 12, 15]))!;
+    expect(p).toMatchObject({ source: 'targeted', asOf: '2026-09-16', siPctFreeFloat: 15, siPctFreeFloatPrior: 10, priorAsOf: '2026-09-11', daysToCover: null, costToBorrowPct: null });
+    expect(p.siChangePct).toBeCloseTo(50);
+    expect(fromHistory('VSH', historyRows([9, 10]))).toMatchObject({ siChangePct: null, priorAsOf: null });
+    expect(fromHistory('VSH', [])).toBeNull();
+    expect(fromHistory('VSH', 'nope')).toBeNull();
+  });
+
+  it('reads the bulk snapshot first, falls back to the per-ticker cache for the rest, and never calls Ortex', async () => {
+    const rest = vi.fn(async (table: string, _m: string, opts: { query: string }) => {
+      if (table === 'ortex_positioning_manifests') return ['2026-09-30', '2026-09-29', '2026-09-26', '2026-09-25', '2026-09-24', '2026-09-23'].map(d => ({ source_date: d }));
+      if (table === 'ortex_positioning_snapshots') return opts.query.includes('2026-09-30') ? [snap('AAA')] : [{ symbol: 'AAA', si_pct_free_float: '10' }];
+      if (table === 'ortex_cache') return [
+        { ticker: 'VSH', data_json: historyRows([10, 10, 11, 11, 12, 12, 15]), fetched_at: '2026-10-05T10:00:00Z' },
+        { ticker: 'VSH', data_json: historyRows([1, 1, 1, 1, 1, 1, 1]), fetched_at: '2026-09-01T10:00:00Z' },
+      ];
+      throw new Error(`unexpected table ${table}`);
+    });
+    const r = await readPlanPositioning(['aaa', 'VSH', 'ZZZ', 'bad symbol!'], rest as never);
+    expect(r.status).toBe('ok');
+    expect(r.bySymbol.AAA).toMatchObject({ source: 'bulk', priorAsOf: '2026-09-23' });
+    expect(r.bySymbol.VSH).toMatchObject({ source: 'targeted', siPctFreeFloat: 15 }); // newest cache row wins
+    expect(r.bySymbol.ZZZ).toBeUndefined(); // no row is data, not a failure
+    const tables = rest.mock.calls.map(c => c[0]);
+    expect(tables).toEqual(['ortex_positioning_manifests', 'ortex_positioning_snapshots', 'ortex_positioning_snapshots', 'ortex_cache']);
+    expect(rest.mock.calls.every(c => c[1] === 'GET')).toBe(true);
+    expect(decodeURIComponent(rest.mock.calls[3][2].query)).toContain('ticker=in.("VSH","ZZZ")');
+  });
+
+  it('a store failure is read_failed (an outage), not an empty read', async () => {
+    const r = await readPlanPositioning(['AAA'], (async () => { throw new Error('db down'); }) as never);
+    expect(r).toEqual({ status: 'read_failed', bySymbol: {} });
+    expect(await readPlanPositioning([], (async () => { throw new Error('unused'); }) as never)).toEqual({ status: 'ok', bySymbol: {} });
+  });
+});
