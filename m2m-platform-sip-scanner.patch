+      throw new SipUnavailable("OUTSIDE_PUBLISH_WINDOW");
+    const date = clock(at).date,
+      deadline = Date.now() + 240000;
+    return this.store.withLock(date, async (owner) => {
+      const existing = await this.store.result(date);
+      if (existing) return existing;
+      const prep = await this.store.preparation(date);
+      if (!prep?.complete || prep.session_date !== date)
+        throw new SipUnavailable("PREPARATION_INCOMPLETE");
+      const volumes = new Map<string, number>();
+      let index = 0;
+      const work = async () => {
+        while (index < prep.rows.length) {
+          const row = prep.rows[index++];
+          const cached = await this.store.symbol(date, `opening:${row.symbol}`);
+          if (cached && "opening_volume" in cached) {
+            volumes.set(row.symbol, cached.opening_volume);
+            continue;
+          }
+          if (Date.now() >= deadline)
+            throw new SipUnavailable("PUBLICATION_BUDGET");
+          const volume = openingVolume(
+            await this.data.openingMinutes(row.symbol, date),
+            date,
+          );
+          await this.store.saveSymbol(
+            date,
+            `opening:${row.symbol}`,
+            { opening_volume: volume },
+            owner,
+          );
+          volumes.set(row.symbol, volume);
+        }
+      };
+      // Wait for every worker to settle before releasing the lease on failure.
+      const jobs = await Promise.allSettled(
+        Array.from({ length: 4 }, () => work()),
+      );
+      for (const job of jobs) if (job.status === "rejected") throw job.reason;
+      const quotes: Record<string, { price: number; at: number }> = {};
+      for (let i = 0; i < prep.rows.length; i += 100) {
+        if (Date.now() >= deadline)
+          throw new SipUnavailable("PUBLICATION_BUDGET");
+        Object.assign(
+          quotes,
+          await this.data.quotes(
+            prep.rows.slice(i, i + 100).map((r) => r.symbol),
+          ),
+        );
+      }
+      const generated = this.now();
+      if (phaseAt(generated) !== "publish")
+        throw new SipUnavailable("PUBLICATION_TOO_LATE");
+      const candidates: SipCandidate[] = prep.rows.map((row) => {
+        const quote = quotes[row.symbol];
+        if (
+          !quote ||
+          quote.at < sessionTime(date, 575).getTime() ||
+          generated.getTime() - quote.at > 120000 ||
+          quote.at - generated.getTime() > 30000 ||
+          !Number.isFinite(quote.price) ||
+          quote.price <= 0
