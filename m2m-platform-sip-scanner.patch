index 00000000..bcf4e2cf
--- /dev/null
+++ b/src/app/the-open/_components/AfterOpenBoard.tsx
@@ -0,0 +1,172 @@
+/**
+ * After-open view (owner, /the-open; OPEN-VIEW-1/-2). Presentational only: renders an AfterOpenModel.
+ *
+ * Measured values (prices, VWAP, ranges, plan levels) render plain; derived values (gap %, % since the
+ * open, volume share, R:R from here, the suggested contract) render in the dotted-amber est. style
+ * (Rule 1). The status is tape context, not edge: no open-time signal has a tested record on these
+ * setups, and the footer says so. No client JavaScript: rows are native <details>.
+ */
+
+import Link from 'next/link';
+import { symbolHref } from '@/components/navGroups';
+import { DERIVED, PLAN_LEVEL, px, sideClass } from '@/components/slate/PlanCard';
+import { PositioningLine } from '@/components/slate/PlanRows';
+import type { AfterOpenModel, AfterOpenRow, StripItem } from '@/lib/open/afterOpenModel';
+import type { TapeStatus } from '@/lib/open/tapeFacts';
+
+const TONE: Record<TapeStatus, string> = {
+  confirming: 'text-green-400 border-green-500/40',
+  waiting: 'text-m2m-ink border-m2m-rule',
+  not_confirming: 'text-amber-300 border-amber-500/40',
+  forming: 'text-m2m-ink-mute border-m2m-rule',
+  unknown: 'text-m2m-ink-mute border-m2m-rule',
+  invalidated: 'text-red-400 border-red-500/40',
+};
+
+const RULE: Record<TapeStatus, string> = {
+  confirming: 'Through the 30-min opening range in the card’s direction, on the right side of VWAP',
+  waiting: 'Inside the opening range, on the card’s side of VWAP',
+  not_confirming: 'Wrong side of VWAP (inside the range, or through it against VWAP)',
+  forming: 'Opening range forms 09:30–10:00 ET; no status before 10:00 unless the stop is hit',
+  unknown: 'Tape inputs missing for this name',
+  invalidated: 'Through the opening range against the card, or at/through the stop',
+};
+
+/** Sector chip tone only (display, no decision): leaders at ≥ +0.9%, laggards below +0.3%, as in the approved mockup. */
+const SECTOR_LEAD_PCT = 0.9;
+const SECTOR_LAG_PCT = 0.3;
+
+const signed = (n: number | null, digits = 2) => (n === null ? '—' : `${n > 0 ? '+' : ''}${n.toFixed(digits)}%`);
+
+function StripTile({ s }: { s: StripItem }) {
+  return (
+    <div className="rounded border border-m2m-rule px-2 py-1" data-strip={s.symbol}>
+      <div className="text-[10px] text-m2m-ink-mute">{s.symbol}</div>
+      <div className="text-[12px] text-m2m-ink">
+        <span style={DERIVED}>{signed(s.changePct)}</span>
+        <span className="ml-1 text-m2m-ink-mute">{s.vsVwap ? `${s.vsVwap} VWAP` : 'VWAP —'}</span>
+      </div>
+    </div>
+  );
+}
+
+function SectorChip({ s }: { s: StripItem }) {
+  const tone = s.changePct === null ? 'text-m2m-ink-mute' : s.changePct >= SECTOR_LEAD_PCT ? 'text-green-400' : s.changePct < SECTOR_LAG_PCT ? 'text-amber-300' : 'text-m2m-ink';
+  return <span className={`rounded border border-m2m-rule px-1.5 text-[10px] ${tone}`} data-sector={s.symbol}>{s.symbol} <span style={DERIVED}>{signed(s.changePct)}</span></span>;
+}
+
+/** The opening range drawn as a bar with VWAP (line) and the last price (block). */
+function RangeBar({ r }: { r: AfterOpenRow }) {
+  const { openingRange: or, vwap, last } = r.facts;
+  if (!or || vwap === null || last === null) return null;
+  const lo = Math.min(or.low, vwap, last), hi = Math.max(or.high, vwap, last);
+  const pad = (hi - lo) * 0.08 || 0.01, a = lo - pad, b = hi + pad;
+  const p = (x: number) => `${(((x - a) / (b - a)) * 100).toFixed(1)}%`;
+  return (
+    <div className="mt-1" data-range-bar>
+      <div className="relative h-3 rounded bg-white/5">
+        <div className="absolute top-[3px] bottom-[3px] rounded bg-white/20" style={{ left: p(or.low), width: `calc(${p(or.high)} - ${p(or.low)})` }} title="30-min opening range" />
+        <div className="absolute top-0 bottom-0 w-[2px] bg-sky-400" style={{ left: p(vwap) }} title="VWAP" />
+        <div className="absolute -top-[2px] h-4 w-2 -translate-x-1/2 rounded-sm bg-m2m-ink" style={{ left: p(last) }} title="last" />
+      </div>
+      <div className="mt-0.5 flex justify-between text-[10px] text-m2m-ink-mute">
+        <span>range {px(or.low)}–{px(or.high)}</span><span className="text-sky-400">VWAP {px(vwap)}</span><span>last {px(last)}</span>
+      </div>
+    </div>
+  );
+}
+
+function ContractLine({ r }: { r: AfterOpenRow }) {
+  if (!r.contract) return <span className="text-m2m-ink-mute">contract: not read</span>;
+  if (r.contract.status !== 'ok') return <span className="text-m2m-ink-mute">contract: {r.contract.reason}</span>;
+  const c = r.contract.contract;
+  return (
+    <span>
+      <span style={DERIVED}>est. {c.expiration.slice(5)} {px(c.strike)} {c.type === 'call' ? 'C' : 'P'} · {px(c.mid)} mid · max loss ${Math.round(c.maxLoss)} · BE {px(c.breakeven)}</span>
+      {c.wide && <span className="ml-1 rounded border border-amber-500/40 px-1 text-[10px] text-amber-300">wide market {Math.round(c.spreadPct * 100)}%</span>}
+    </span>
+  );
+}
+
+function Row({ r }: { r: AfterOpenRow }) {
+  const s = r.candidate.setup;
+  const sym = s.symbol.toUpperCase();
+  const f = r.facts;
+  // `forming` is only ever returned before 10:00 ET (classifyTape), when OPEN-VIEW-1 shows no status: such a row
+  // carries no chip and its group heading says "Range forming".
+  const chip = r.read.status === 'forming' ? null : <span className={`rounded border px-1.5 text-[10px] ${TONE[r.read.status]}`} title={RULE[r.read.status]}>{r.read.status.replace('_', ' ')}</span>;
+  if (r.read.status === 'invalidated') {
+    return (
+      <div className="flex flex-wrap items-baseline gap-2 border-b border-m2m-rule py-1.5 text-[12px]" data-open-row={sym} data-status={r.read.status}>
+        <Link href={symbolHref(sym)} className="font-semibold text-m2m-ink">{sym}</Link>
+        <span className={`text-[10px] uppercase ${sideClass(s.direction)}`}>{s.direction}</span>{chip}
+        <span className="text-m2m-ink-mute">{r.read.reason} · last {px(f.last)}</span>
+      </div>
+    );
+  }
+  return (
+    <details className="border-b border-m2m-rule py-2" data-open-row={sym} data-status={r.read.status}>
+      <summary className="cursor-pointer list-none">
+        <div className="flex flex-wrap items-baseline gap-2 text-[12px]">
+          <Link href={symbolHref(sym)} className="text-[14px] font-semibold text-m2m-ink">{sym}</Link>
+          <span className={`text-[10px] uppercase ${sideClass(s.direction)}`}>{s.direction}</span>{chip}
+          {!r.inPlan && <span className="text-[10px] text-m2m-ink-mute">also qualifies</span>}
+          <span className="ml-auto text-m2m-ink"><b>{px(f.last)}</b> <span style={DERIVED}>{signed(f.sinceOpenPct)}</span> <span className="text-m2m-ink-mute">since open</span></span>
+        </div>
+        <div className="mt-0.5 text-[11px] text-m2m-ink-mute">{r.read.reason}</div>
+        <RangeBar r={r} />
+        <div className="mt-1 grid grid-cols-2 gap-x-3 gap-y-0.5 text-[11px] sm:grid-cols-4">
+          <span>gap <span style={DERIVED}>{signed(f.gapPct)}</span></span>
+          <span>volume <span style={DERIVED}>{f.volumeShare === null ? '—' : `${Math.round(f.volumeShare * 100)}% of avg day`}</span></span>
+          <span>R:R from here <span style={DERIVED}>{r.rrLive === null ? '—' : r.rrLive.toFixed(2)}</span></span>
+          <span>stop → target <span style={PLAN_LEVEL}>{px(s.stop)} → {px(s.target)}</span></span>
+        </div>
+        <div className="mt-1 text-[11px]"><PositioningLine pos={r.positioning} /></div>
+      </summary>
+      <div className="mt-2 space-y-1 text-[11px] text-m2m-ink-mute">
+        <div><ContractLine r={r} /></div>
+        <div>pre-market {f.premarket ? `${px(f.premarket.low)}–${px(f.premarket.high)}` : '—'} · plan levels from the {s.sessionDate} card ({s.strategy})</div>
+        <div><Link href={symbolHref(sym)} className="underline">Open {sym}: chart, expert read and full card</Link></div>
+      </div>
+    </details>
+  );
+}
+
+export default function AfterOpenBoard({ model, now }: { model: AfterOpenModel; now: Date }) {
+  const time = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' }).format(now);
+  const summary = model.groups.map(g => `${g.rows.length} ${g.label.toLowerCase()}`).join(' · ');
+  return (
+    <section className="mx-auto max-w-6xl px-4 py-4" data-module="after-open" data-state={model.state}>
+      <div className="flex flex-wrap items-baseline justify-between gap-2">
+        <h2 className="text-lg font-semibold text-m2m-ink">After the open</h2>
+        <span className="text-[11px] text-m2m-ink-mute">{model.sessionDate} · {time} ET · Polygon; VIX Yahoo</span>
+      </div>
+      <div className="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
+        {model.indices.map(s => <StripTile key={s.symbol} s={s} />)}
+        <div className="rounded border border-m2m-rule px-2 py-1" data-strip="VIX">
+          <div className="text-[10px] text-m2m-ink-mute">VIX</div>
+          <div className="text-[12px] text-m2m-ink">{px(model.vix.value)} <span style={DERIVED}>{signed(model.vix.changePct)}</span></div>
+        </div>
+      </div>
+      <div className="mt-2 flex flex-wrap gap-1">{model.sectors.map(s => <SectorChip key={s.symbol} s={s} />)}</div>
+      {model.notes.length > 0 && <p className="mt-2 text-[11px] text-amber-300" data-open-notes>{model.notes.join(' ')}</p>}
+
+      {model.state === 'not_session_day' && <p className="mt-4 text-[12px] text-m2m-ink-mute">No session today. The next plan is for {model.sessionDate}; its tape read starts at the open.</p>}
+      {model.state === 'no_plan' && <p className="mt-4 text-[12px] text-m2m-ink-mute">The setup source could not be read; no claim about the tape is made.</p>}
+      {model.state === 'session' && model.groups.length === 0 && <p className="mt-4 text-[12px] text-m2m-ink-mute">No single stock qualifies for today’s plan.</p>}
+      {model.state === 'session' && model.groups.length > 0 && <p className="mt-3 text-[12px] text-m2m-ink">{summary}</p>}
+
+      {model.groups.map(g => (
+        <div key={g.status} className="mt-3" data-open-group={g.status}>
+          <div className="text-[11px] uppercase tracking-wide text-m2m-ink-mute" title={RULE[g.status]}>{g.label} ({g.rows.length}) <span className="normal-case tracking-normal">· {RULE[g.status]}</span></div>
+          {g.rows.map(r => <Row key={r.candidate.setup.id} r={r} />)}
+        </div>
+      ))}
+
+      <p className="mt-4 text-[10px] text-m2m-ink-mute">
+        Status is tape context, not edge: no open-time signal has a tested record on these setups. Dotted amber values are derived (est.);
+        plan levels are the scanner’s, not market prices. Volume share compares volume so far with a full average day, so it reads low early.
+      </p>
+    </section>
+  );
+}
diff --git a/src/app/the-open/_components/AfterOpenView.tsx b/src/app/the-open/_components/AfterOpenView.tsx
