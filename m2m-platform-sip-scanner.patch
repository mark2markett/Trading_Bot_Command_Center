+import { getAccessToken, invalidateSchwabAccessToken } from '@/services/schwabService';
+import { previousSessions, sessionTime } from './calendar';
+import { SipUnavailable, type SipBar } from './contract';
+
+export interface SipData {
+ dailyBars(symbol:string,date:string):Promise<SipBar[]>;
+ historyMinutes(symbol:string,date:string):Promise<SipBar[]>;
+ openingMinutes(symbol:string,date:string):Promise<SipBar[]>;
+ quotes(symbols:string[]):Promise<Record<string,{price:number;at:number}>>;
+}
+/** Only market-data GETs. OAuth remains owned by the existing platform service. */
+export class SchwabSipData implements SipData {
+ constructor(private token=getAccessToken,private invalidate:()=>void=invalidateSchwabAccessToken,private fetcher:typeof fetch=fetch){}
+ private async get(path:'pricehistory'|'quotes',params:Record<string,string>):Promise<any>{
+  const url=new URL(`https://api.schwabapi.com/marketdata/v1/${path}`);
+  for(const [key,value] of Object.entries(params))url.searchParams.set(key,value);
+  for(let attempt=0;attempt<2;attempt++){
+   let response:Response;
+   try {response=await this.fetcher(url,{method:'GET',headers:{Authorization:`Bearer ${await this.token()}`},signal:AbortSignal.timeout(20_000),redirect:'error',cache:'no-store'});}
+   catch{throw new SipUnavailable('SCHWAB_REQUEST_FAILED');}
+   if(response.status===401 && attempt===0){this.invalidate();continue;}
+   if(!response.ok)throw new SipUnavailable(`SCHWAB_HTTP_${response.status}`);
+   try{return await response.json();}catch{throw new SipUnavailable('SCHWAB_SCHEMA');}
+  }
+  throw new SipUnavailable('SCHWAB_AUTH_FAILED');
+ }
+ private async bars(symbol:string,start:number,end:number,frequencyType:'daily'|'minute'):Promise<SipBar[]>{
+  const data=await this.get('pricehistory',{symbol,periodType:frequencyType==='daily'?'month':'day',frequencyType,frequency:'1',startDate:String(start),endDate:String(end),needExtendedHoursData:'false'});
+  if(!Array.isArray(data.candles))throw new SipUnavailable('SCHWAB_SCHEMA');
+  return data.candles.map((b:any)=>({t:b.datetime,o:b.open,h:b.high,l:b.low,c:b.close,v:b.volume}));
+ }
+ dailyBars(symbol:string,date:string){const end=sessionTime(date,0).getTime();return this.bars(symbol,end-90*86_400_000,end,'daily');}
+ historyMinutes(symbol:string,date:string){const prior=previousSessions(date,14);return this.bars(symbol,sessionTime(prior[13],570).getTime(),sessionTime(prior[0],575).getTime(),'minute');}
+ openingMinutes(symbol:string,date:string){return this.bars(symbol,sessionTime(date,570).getTime(),sessionTime(date,575).getTime(),'minute');}
+ async quotes(symbols:string[]){
+  if(!symbols.length)return {};
+  const data=await this.get('quotes',{symbols:symbols.join(','),fields:'quote,reference'});
+  const result:Record<string,{price:number;at:number}>={};
+  for(const symbol of symbols){const q=data[symbol]?.quote;if(!q || !Number.isFinite(q.lastPrice) || !Number.isFinite(q.quoteTime))throw new SipUnavailable('SCHWAB_QUOTE_INCOMPLETE');result[symbol]={price:q.lastPrice,at:q.quoteTime};}
+  return result;
+ }
+}
