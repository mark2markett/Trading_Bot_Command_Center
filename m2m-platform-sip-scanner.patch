+/** Dedicated paper-fleet scanner contract. All prices/volumes originate in Schwab data. */
+export interface SipBar { t: number; o: number; h: number; l: number; c: number; v: number }
+export interface PreparationRow { symbol: string; atr14: number; avg_vol: number; opening_mean: number }
+export interface SipCandidate { symbol: string; price: number; rvol: number; atr14: number; avg_vol: number }
+export interface Exclusion { symbol: string; reason: string }
+export interface SipSnapshot {
+  version: 1; status: 'ready'; session_date: string; generated_at: string;
+  window_start: string; window_end: string; candidates: SipCandidate[];
+  coverage: { universe: number; eligible: number; observed: number; excluded: number };
+  exclusions: Exclusion[];
+}
+export interface Preparation {
+  version: 1; session_date: string; generated_at: string; universe: string[];
+  rows: PreparationRow[]; exclusions: Exclusion[]; failures: Exclusion[]; complete: boolean;
+}
+export class SipExcluded extends Error {
+  constructor(public readonly code: string) { super(code); this.name = 'SipExcluded'; }
+}
+export class SipUnavailable extends Error {
+  constructor(public readonly code: string) { super(code); this.name = 'SipUnavailable'; }
+}
