+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Redis } from "@upstash/redis";
+import snapshot from "../../../../../../../tests/fixtures/sip/sip-v1-ready.json";
+import { SipStore } from "@/lib/sip/store";
+import { SchwabSipData } from "@/lib/sip/schwab";
+import { GET } from "../route";
+
+const secret = "fixture-scanner-secret-32-characters";
+const request = (token = secret) => new Request("https://test.invalid/api/internal/cc/sip-scanner", {
+  headers: { Authorization: `Bearer ${token}` },
+});
+
+describe("actual machine read route", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date(snapshot.generated_at));
+    vi.stubEnv("SIP_SCANNER_ENABLED", "true");
+    vi.stubEnv("SIP_SCANNER_SECRET", secret);
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+    vi.useRealTimers();
+  });
+
+  it.each(["disabled", "unauthorized", "misconfigured"])("refuses %s before storage or provider access", async (caseName) => {
+    if (caseName === "disabled") vi.stubEnv("SIP_SCANNER_ENABLED", "false");
+    if (caseName === "misconfigured") vi.stubEnv("SIP_SCANNER_SECRET", "short");
+    const store = vi.spyOn(SipStore, "fromEnvironment");
+    const provider = vi.spyOn(SchwabSipData.prototype, "dailyBars");
+    const response = await GET(request(caseName === "unauthorized" ? "wrong-token" : secret));
+    expect(response.status).toBe(caseName === "disabled" ? 404 : caseName === "unauthorized" ? 401 : 503);
+    expect(response.headers.get("Cache-Control")).toContain("no-store");
+    expect(store).not.toHaveBeenCalled();
+    expect(provider).not.toHaveBeenCalled();
+  });
+
+  it.each([null, snapshot, { version: 2 }, "storage-failed"])("wires current-session storage outcome %# through the endpoint", async (value) => {
+    const redis = {
+      get: vi.fn<Redis["get"]>(), set: vi.fn<Redis["set"]>(), eval: vi.fn<Redis["eval"]>(),
+    };
+    if (value === "storage-failed") redis.get.mockRejectedValue(new Error("fixture storage outage"));
+    else redis.get.mockResolvedValue(value);
+    const store = vi.spyOn(SipStore, "fromEnvironment").mockReturnValue(new SipStore(redis));
+    const provider = vi.spyOn(SchwabSipData.prototype, "dailyBars");
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const response = await GET(request());
+    expect(response.status).toBe(value === null ? 202 : value === snapshot ? 200 : 503);
+    expect(response.headers.get("Cache-Control")).toContain("no-store");
+    expect(store).toHaveBeenCalledOnce();
+    expect(redis.get).toHaveBeenCalledWith("cc:sip:v1:2026-10-06:result");
+    expect(redis.set).not.toHaveBeenCalled();
+    expect(redis.eval).not.toHaveBeenCalled();
+    expect(provider).not.toHaveBeenCalled();
+    if (value === snapshot) expect(await response.json()).toEqual(snapshot);
+    else if (value !== null) expect(await response.json()).toEqual({ error: "scanner_unavailable" });
+  });
+});
