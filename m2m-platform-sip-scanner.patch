+import { ALL_SYMBOLS } from "@/config/watchlist";
+import { SYMBOL_SECTOR } from "@/config/universeSectors";
+import { startCronRun, finishCronRun } from "@/lib/cronRunLog";
+import { stockUniverse } from "@/lib/sip/calculation";
+import { phaseAt, SipScanner } from "@/lib/sip/service";
+import { SchwabSipData } from "@/lib/sip/schwab";
+import { SipStore } from "@/lib/sip/store";
+import { SipExcluded, SipUnavailable } from "@/lib/sip/contract";
+import { NO_STORE, safeEqual } from "@/lib/sip/http";
+export const dynamic = "force-dynamic";
+export const maxDuration = 300;
+export async function GET(request: Request) {
+  const secret = process.env.CRON_SECRET;
+  if (
+    !secret ||
+    !safeEqual(request.headers.get("authorization"), `Bearer ${secret}`)
+  )
+    return Response.json(
+      { error: "unauthorized" },
+      { status: 401, headers: NO_STORE },
+    );
+  const now = new Date(),
+    phase = phaseAt(now);
+  if (process.env.SIP_SCANNER_ENABLED !== "true" || !phase)
+    return Response.json({ status: "skipped" }, { headers: NO_STORE });
+  const runId = await startCronRun("cc-sip-scanner", { phase });
+  try {
+    const universe = stockUniverse(ALL_SYMBOLS, SYMBOL_SECTOR);
+    const scanner = new SipScanner(
+      new SchwabSipData(),
+      SipStore.fromEnvironment(),
+      universe,
+    );
+    const result =
+      phase === "prepare"
+        ? await scanner.prepare(now)
+        : await scanner.publish(now);
+    const complete = result && ("complete" in result ? result.complete : true);
+    const summary = {
+      phase,
+      status: !result ? "busy" : complete ? "ready" : "pending",
+      universe: universe.length,
+      classificationExcluded: ALL_SYMBOLS.length - universe.length,
+      coverage: result && "coverage" in result ? result.coverage : null,
+      failures: result && "failures" in result ? result.failures.length : 0,
+    };
+    console.info("[cc-sip]", JSON.stringify(summary));
+    await finishCronRun(runId, complete ? "success" : "failure", summary);
+    return Response.json(summary, {
+      status: !result ? 202 : complete ? 200 : 503,
+      headers: NO_STORE,
+    });
+  } catch (error) {
+    const code =
+      error instanceof SipUnavailable || error instanceof SipExcluded
+        ? error.code
+        : "SIP_SCANNER_FAILED";
+    console.error("[cc-sip]", code);
+    await finishCronRun(runId, "failure", { phase, error: code });
+    return Response.json({ error: code }, { status: 503, headers: NO_STORE });
+  }
+}
