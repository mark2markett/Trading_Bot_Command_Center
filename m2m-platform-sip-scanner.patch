@@ -0,0 +1,105 @@
+/**
+ * Loader for the after-open view: plan → tape reads → model. Each vendor read is isolated: a failure
+ * leaves that part empty and is named in `notes`, never filled.
+ *
+ * The plan is the Slate plan for the next session (`getMondayPlan`); during a trading day that is
+ * today. Outside a trading day (weekend, holiday, after 17:00 ET when the plan rolls forward) the view
+ * says so and makes no vendor or store read at all (no strip, no VIX, no positioning). The same holds when
+ * the plan itself is unreadable: the view says so and reads nothing else.
+ */
+
+import { getMondayPlan, type MondayPlan } from '@/lib/slate/mondayPlan';
+import { getPlanBoardExtras } from '@/lib/slate/planBoardExtras';
+import { fetchYahooQuotes } from '@/lib/yahoo-quotes';
+import { etDateYmd } from '@/lib/marketSession';
+import { computeTapeFacts, type TapeFacts } from '@/lib/open/tapeFacts';
+import { readDailyVolumes, readMinuteBars, readTapeSnapshots, type TapeQuote } from '@/lib/open/tapeReader';
+import {
+  buildAfterOpenModel, INDEX_SYMBOLS, qualifyingStocks, SECTOR_SYMBOLS, type AfterOpenModel, type StripQuote,
+} from '@/lib/open/afterOpenModel';
+import type { PlanContractResult } from '@/lib/slate/planContract';
+import { readPlanPositioning, type PlanPositioningRead } from '@/lib/slate/planPositioning';
+
+export interface AfterOpenDeps {
+  plan: (now: Date) => Promise<MondayPlan>;
+  snapshots: typeof readTapeSnapshots;
+  minuteBars: typeof readMinuteBars;
+  dailyVolumes: typeof readDailyVolumes;
+  contracts: (plan: MondayPlan, now: Date) => Promise<Record<string, PlanContractResult>>;
+  vix: () => Promise<{ value: number | null; changePct: number | null }>;
+  positioning: (symbols: string[]) => Promise<PlanPositioningRead>;
+}
+
+const defaultDeps: AfterOpenDeps = {
+  plan: (now) => getMondayPlan(now),
+  snapshots: (s) => readTapeSnapshots(s),
+  minuteBars: (s, d) => readMinuteBars(s, d),
+  dailyVolumes: (s, d) => readDailyVolumes(s, d),
+  contracts: async (plan, now) => (await getPlanBoardExtras(plan, now, { contractsFor: 'qualifying' })).contracts,
+  vix: async () => {
+    const q = (await fetchYahooQuotes(['^VIX']))['^VIX'];
+    return { value: q?.price ?? null, changePct: q?.change_pct ?? null };
+  },
+  positioning: (symbols) => readPlanPositioning(symbols),
+};
+
+export async function loadAfterOpen(now: Date = new Date(), overrides: Partial<AfterOpenDeps> = {}): Promise<AfterOpenModel> {
+  const d = { ...defaultDeps, ...overrides };
+  const notes: string[] = [];
+  const plan = await d.plan(now).catch((): MondayPlan => ({
+    sessionDate: null, nextSession: etDateYmd(now), plan: [], alsoQualify: [], nearMisses: [], stocks: [], etfs: [], source: 'unavailable',
+    counts: { published: 0, live: 0, shadow: 0, stocks: 0, etfs: 0, stocksWithFlowSide: 0, stocksWithFlowRead: 0, notEvaluated: 0 },
+  }));
+  const sessionDate = plan.nextSession;
+  const isSessionDay = etDateYmd(now) === sessionDate;
+  if (!isSessionDay || plan.source === 'unavailable') {
+    return buildAfterOpenModel({
+      plan, sessionDate, isSessionDay, facts: new Map(), priceAt: new Map(), contracts: {}, positioning: {},
+      strip: new Map(), vix: { value: null, changePct: null }, notes,
+    });
+  }
+  const stocks = qualifyingStocks(plan).map(x => x.c.setup.symbol.toUpperCase());
+  const stripSymbols = [...INDEX_SYMBOLS, ...SECTOR_SYMBOLS];
+
+  const [snapR, vixR, contractsR, perName, posR] = await Promise.all([
+    d.snapshots([...stocks, ...stripSymbols]).catch(() => null),
+    d.vix().catch(() => null),
+    stocks.length > 0 ? d.contracts(plan, now).catch(() => null) : Promise.resolve({}),
+    stocks.length > 0
+      ? Promise.all(stocks.map(async s => {
+        const [bars, vols] = await Promise.allSettled([d.minuteBars(s, sessionDate), d.dailyVolumes(s, sessionDate)]);
+        return { s, bars: bars.status === 'fulfilled' ? bars.value : null, vols: vols.status === 'fulfilled' ? vols.value : null };
+      }))
+      : Promise.resolve([]),
+    stocks.length > 0 ? d.positioning(stocks).catch(() => null) : Promise.resolve({ status: 'ok' as const, bySymbol: {} }),
+  ]);
+
+  const snaps: Map<string, TapeQuote> = snapR?.quotes ?? new Map();
+  if (!snapR) notes.push('Live prices could not be read (vendor request failed).');
+  else if (snapR.failed.length > 0) notes.push(`Live prices could not be read for ${snapR.failed.join(', ')} (vendor request failed).`);
+  if (!vixR) notes.push('VIX could not be read.');
+  if (!contractsR) notes.push('Suggested contracts could not be read.');
+  if (!posR || posR.status === 'read_failed') notes.push('Short positioning could not be read (stored Ortex data unavailable).');
+  const barFails = perName.filter(p => p.bars === null).map(p => p.s);
+  if (barFails.length > 0) notes.push(`Intraday bars could not be read for ${barFails.join(', ')}.`);
+  const volFails = perName.filter(p => p.vols === null).map(p => p.s);
+  if (volFails.length > 0) notes.push(`The 20-day volume baseline could not be read for ${volFails.join(', ')}; volume share omitted.`);
+
+  const facts = new Map<string, TapeFacts>();
+  const priceAt = new Map<string, string>();
+  for (const p of perName) {
+    const snap = snaps.get(p.s) ?? null;
+    facts.set(p.s, computeTapeFacts({ sessionDate, bars: p.bars ?? [], snapshot: snap, dailyVolumes: p.vols ?? [], now }));
+    if (snap) priceAt.set(p.s, snap.at);
+  }
+  const strip = new Map<string, StripQuote>();
+  for (const s of stripSymbols) {
+    const q = snaps.get(s);
+    if (q) strip.set(s, { last: q.last, prevClose: q.prevClose, vwap: q.vwap });
+  }
+
+  return buildAfterOpenModel({
+    plan, sessionDate, isSessionDay, facts, priceAt, contracts: contractsR ?? {}, positioning: posR?.bySymbol ?? {}, strip,
+    vix: vixR ?? { value: null, changePct: null }, notes,
+  });
+}
