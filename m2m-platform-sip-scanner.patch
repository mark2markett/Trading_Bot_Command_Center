new file mode 100644
index 00000000..cc086455
--- /dev/null
+++ b/src/lib/sip/__tests__/infrastructure.test.ts
@@ -0,0 +1,110 @@
+import { describe, it, expect, vi } from "vitest";
+import { SchwabSipData } from "../schwab";
+import { SipStore } from "../store";
+
+describe("read-only Schwab boundary", () => {
+  it("uses only pricehistory GET and retries a single 401 with token invalidation", async () => {
+    const fetcher = vi
+      .fn()
+      .mockResolvedValueOnce(new Response("", { status: 401 }))
+      .mockResolvedValue(
+        new Response(
+          JSON.stringify({
+            candles: [
+              {
+                datetime: 123,
+                open: 10,
+                high: 11,
+                low: 9,
+                close: 10,
+                volume: 100,
+              },
+            ],
+          }),
+        ),
+      );
+    const invalidate = vi.fn();
+    const data = new SchwabSipData(
+      async () => "private-token",
+      invalidate,
+      fetcher,
+    );
+    expect(await data.dailyBars("NVDA", "2026-10-06")).toHaveLength(1);
+    expect(invalidate).toHaveBeenCalledTimes(1);
+    expect(fetcher).toHaveBeenCalledTimes(2);
+    const [url, options] = fetcher.mock.calls[0];
+    expect(url.pathname).toBe("/marketdata/v1/pricehistory");
+    expect(options.method).toBe("GET");
+    expect(options.redirect).toBe("error");
+  });
+  it("never exposes upstream errors or token values", async () => {
+    const data = new SchwabSipData(
+      async () => "private-token",
+      () => {},
+      vi.fn().mockResolvedValue(new Response("private-token", { status: 500 })),
+    );
+    await expect(data.dailyBars("NVDA", "2026-10-06")).rejects.toThrow(
+      "SCHWAB_HTTP_500",
+    );
+  });
+  it("rejects bad provider schemas rather than reporting empty history", async () => {
+    const data = new SchwabSipData(
+      async () => "private-token",
+      () => {},
+      vi.fn().mockResolvedValue(new Response("{}")),
+    );
+    await expect(data.historyMinutes("NVDA", "2026-10-06")).rejects.toThrow(
+      "SCHWAB_SCHEMA",
+    );
+  });
+});
+describe("durable ownership", () => {
+  it("requires Redis configuration", () => {
+    vi.stubEnv("UPSTASH_REDIS_REST_URL", "");
+    expect(() => SipStore.fromEnvironment()).toThrow(
+      "SIP_STORAGE_UNCONFIGURED",
+    );
+    vi.unstubAllEnvs();
+  });
+  it("stores an immutable result with date-scoped key and retention", async () => {
+    const redis = { set: vi.fn(), eval: vi.fn().mockResolvedValue("OK") };
+    const store = new SipStore(redis as any);
+    await store.saveResult("2026-10-06", {} as any, "owner");
+    // Publication is fenced atomically against the owner, as well as SET NX.
+    expect(redis.set).not.toHaveBeenCalled();
+    expect(redis.eval.mock.calls[0][0]).toContain("'NX'");
+    expect(redis.eval.mock.calls[0][1][1]).toBe("cc:sip:v1:2026-10-06:result");
+    expect(redis.eval.mock.calls[0][2][3]).toBe(604800);
+  });
+  it("releases only its own lock after callbacks, including failures", async () => {
+    const redis = {
+      set: vi.fn().mockResolvedValue("OK"),
+      eval: vi.fn().mockResolvedValue(1),
+    };
+    const store = new SipStore(redis as any);
+    await expect(
+      store.withLock("2026-10-06", async () => {
+        throw new Error("stop");
+      }),
+    ).rejects.toThrow("stop");
+    expect(redis.set.mock.calls[0][0]).toBe("cc:sip:v1:2026-10-06:lock");
+    expect(redis.set.mock.calls[0][2]).toEqual({ nx: true, ex: 330 });
+    expect(redis.eval.mock.calls[0][0]).toContain("redis.call('get'");
+    expect(redis.eval.mock.calls[0][1]).toEqual(["cc:sip:v1:2026-10-06:lock"]);
+  });
+  it("does not execute overlapping work", async () => {
+    const redis = { set: vi.fn().mockResolvedValue(null) };
+    const work = vi.fn();
+    expect(await new SipStore(redis as any).withLock("2026-10-06", work)).toBe(
+      null,
+    );
+    expect(work).not.toHaveBeenCalled();
+  });
+  it("fences writes if the lock has expired or changed owner", async () => {
+    const redis = { eval: vi.fn().mockResolvedValue(-1) };
+    const store = new SipStore(redis as any);
+    await expect(
+      store.saveResult("2026-10-06", {} as any, "old-owner"),
+    ).rejects.toThrow("SIP_LOCK_LOST");
+  });
+});
diff --git a/src/lib/sip/__tests__/service.test.ts b/src/lib/sip/__tests__/service.test.ts
