+      const result: Preparation = {
+        version: 1,
+        session_date: date,
+        generated_at: this.now().toISOString(),
+        universe: this.universe,
+        rows: [],
+        exclusions: [],
+        failures: [],
+        complete: false,
+      };
+      let index = 0;
+      const work = async () => {
+        while (index < this.universe.length) {
+          const symbol = this.universe[index++];
+          try {
+            const cached = await this.store.symbol(date, symbol);
+            if (cached && "row" in cached) {
+              result.rows.push(cached.row);
+              continue;
+            }
+            if (cached && "exclusion" in cached) {
+              result.exclusions.push(cached.exclusion);
+              continue;
+            }
+            if (Date.now() >= deadline) {
+              result.failures.push({ symbol, reason: "PREPARATION_BUDGET" });
+              continue;
+            }
+            const daily = await this.data.dailyBars(symbol, date);
+            dailyEligibility(date, daily);
+            const row = preparationFromBars(
+              symbol,
+              date,
+              daily,
+              await this.data.historyMinutes(symbol, date),
+            );
