+++ b/src/lib/open/__tests__/tapeFacts.test.ts
@@ -0,0 +1,122 @@
+import { describe, expect, it } from 'vitest';
+import fixture from './fixtures/tape-2026-10-05.json';
+import { classifyTape, computeTapeFacts, type MinuteBar, type TapeFacts, type TapeSide } from '../tapeFacts';
+
+type Named = { side: TapeSide; stop: number; snapshot: { last: number; open: number; prevClose: number; vwap: number; volume: number }; dailyVolumes: number[]; bars: number[][] };
+const names = fixture.names as unknown as Record<string, Named>;
+const toBars = (rows: number[][]): MinuteBar[] => rows.map(([t, h, l, v]) => ({ t, h, l, v }));
+const factsFor = (sym: string, now = new Date(fixture.now)) => {
+  const n = names[sym];
+  return computeTapeFacts({ sessionDate: fixture.sessionDate, bars: toBars(n.bars), snapshot: n.snapshot, dailyVolumes: n.dailyVolumes, now });
+};
+const read = (sym: string, now?: Date) => classifyTape(factsFor(sym, now), names[sym].side, names[sym].stop);
+
+describe('tape facts on real 2026-10-05 Polygon bars (12:57 ET)', () => {
+  it('derives the opening range, gap, move since the open and volume share from vendor values', () => {
+    const mmm = factsFor('MMM');
+    expect(mmm.openingRange).toEqual({ high: 161.34, low: 159.9201 });
+    expect(mmm.gapPct).toBeCloseTo(-0.3397, 4);
+    expect(mmm.sinceOpenPct).toBeCloseTo(0.9855, 4);
+    expect(mmm.volumeShare).toBeCloseTo(0.2365, 4);
+    expect(factsFor('NBIS').openingRange).toEqual({ high: 244.49, low: 234.59 });
+    expect(factsFor('BAC').openingRange).toEqual({ high: 54.17, low: 53.69 });
+  });
+
+  it('reads the pre-market range from bars before 09:30 ET only', () => {
+    expect(factsFor('NVDA').premarket).toEqual({ high: 236.52, low: 233.95 });
+    expect(factsFor('MMM').premarket).toEqual({ high: 161.5, low: 161.5 });
+  });
+
+  it('classifies each card by OPEN-VIEW-1', () => {
+    expect(read('MMM')).toMatchObject({ status: 'confirming' });
+    expect(read('MCHP')).toMatchObject({ status: 'waiting' });
+    expect(read('NVDA')).toMatchObject({ status: 'not_confirming' });
+    expect(read('MARA')).toMatchObject({ status: 'not_confirming' });
+    expect(read('NBIS')).toMatchObject({ status: 'invalidated', reason: 'below the opening-range low' });
+    expect(read('PATH')).toMatchObject({ status: 'invalidated', reason: 'at or through the stop' });
+    expect(read('BAC')).toMatchObject({ status: 'invalidated', reason: 'above the opening-range high' });
+  });
+
+  it('gives no status while the range forms (before 10:00 ET), except a stop hit, which is Invalidated at once (OPEN-VIEW-2)', () => {
+    const at945 = new Date('2026-10-05T13:45:00.000Z');
+    expect(factsFor('MMM', at945).openingRange).toBeNull();
+    expect(read('MMM', at945)).toMatchObject({ status: 'forming' });
+    expect(read('PATH', at945)).toMatchObject({ status: 'invalidated', reason: 'at or through the stop' });
+    expect(read('MMM', new Date('2026-10-05T14:00:00.000Z')).status).not.toBe('forming');
+  });
+});
+
+describe('classifyTape edges', () => {
+  const f = (over: Partial<TapeFacts>): TapeFacts => ({
+    sessionDate: '2026-10-05', last: 100, vwap: 99, gapPct: 0, sinceOpenPct: 0, premarket: null,
+    openingRange: { high: 101, low: 98 }, openingRangeComplete: true, avgDailyVolume: null, volumeShare: null, ...over,
+  });
+
+  it('bearish mirrors bullish', () => {
+    expect(classifyTape(f({ last: 97, vwap: 99 }), 'bearish', 105)).toMatchObject({ status: 'confirming' });
+    expect(classifyTape(f({ last: 99, vwap: 100 }), 'bearish', 105)).toMatchObject({ status: 'waiting' });
+    expect(classifyTape(f({ last: 100, vwap: 99 }), 'bearish', 105)).toMatchObject({ status: 'not_confirming' });
+    expect(classifyTape(f({ last: 102 }), 'bearish', 105)).toMatchObject({ status: 'invalidated' });
+    expect(classifyTape(f({ last: 100 }), 'bearish', 100)).toMatchObject({ status: 'invalidated', reason: 'at or through the stop' });
+  });
+
+  it('range and VWAP boundaries: at the high is inside; at VWAP is waiting', () => {
+    expect(classifyTape(f({ last: 101, vwap: 99 }), 'bullish', null)).toMatchObject({ status: 'waiting' });
+    expect(classifyTape(f({ last: 100, vwap: 100 }), 'bullish', null)).toMatchObject({ status: 'waiting' });
+    expect(classifyTape(f({ last: 100, vwap: 100 }), 'bearish', null)).toMatchObject({ status: 'waiting' });
+    expect(classifyTape(f({ last: 101, vwap: 101 }), 'bearish', null)).toMatchObject({ status: 'waiting' });
+    expect(classifyTape(f({ last: 98, vwap: 99 }), 'bullish', null)).toMatchObject({ status: 'not_confirming' });
+  });
+
+  it('through the range on the wrong side of VWAP is Not confirming: VWAP decides a breakout (OPEN-VIEW-2)', () => {
+    expect(classifyTape(f({ last: 102, vwap: 103 }), 'bullish', null)).toMatchObject({ status: 'not_confirming', reason: 'above the range but not above VWAP' });
+    expect(classifyTape(f({ last: 102, vwap: 102 }), 'bullish', null)).toMatchObject({ status: 'not_confirming' });
+    expect(classifyTape(f({ last: 97, vwap: 96 }), 'bearish', null)).toMatchObject({ status: 'not_confirming', reason: 'below the range but not below VWAP' });
+  });
+
+  it('a stop hit is Invalidated before 10:00 ET too; without a live price it stays forming', () => {
+    expect(classifyTape(f({ openingRangeComplete: false, openingRange: null, last: 95 }), 'bullish', 96)).toMatchObject({ status: 'invalidated' });
+    expect(classifyTape(f({ openingRangeComplete: false, openingRange: null, last: 106 }), 'bearish', 105)).toMatchObject({ status: 'invalidated' });
+    expect(classifyTape(f({ openingRangeComplete: false, openingRange: null, last: null }), 'bullish', 96)).toMatchObject({ status: 'forming' });
+  });
+
+  it('missing inputs are unknown, not a reading', () => {
+    expect(classifyTape(f({ openingRange: null }), 'bullish', null)).toMatchObject({ status: 'unknown' });
+    expect(classifyTape(f({ last: null }), 'bullish', null)).toMatchObject({ status: 'unknown' });
+  });
+});
+
+describe('computeTapeFacts guards', () => {
+  const base = { sessionDate: '2026-10-05', bars: [] as MinuteBar[], now: new Date('2026-10-05T16:57:00.000Z') };
+  it('volume share needs 20 completed sessions of positive volume', () => {
+    const snap = { last: 1, open: 1, prevClose: 1, vwap: 1, volume: 50 };
+    expect(computeTapeFacts({ ...base, snapshot: snap, dailyVolumes: Array(19).fill(100) }).volumeShare).toBeNull();
+    expect(computeTapeFacts({ ...base, snapshot: snap, dailyVolumes: [...Array(19).fill(100), 0] }).volumeShare).toBeNull();
+    expect(computeTapeFacts({ ...base, snapshot: snap, dailyVolumes: [5, ...Array(20).fill(100)] }).volumeShare).toBe(0.5);
+    expect(computeTapeFacts({ ...base, snapshot: { ...snap, volume: 0 }, dailyVolumes: Array(20).fill(100) }).volumeShare).toBeNull();
+  });
+  it('no snapshot gives no price-derived facts', () => {
+    expect(computeTapeFacts({ ...base, snapshot: null, dailyVolumes: [] })).toMatchObject({ last: null, vwap: null, gapPct: null, sinceOpenPct: null, volumeShare: null });
+  });
+  it('the pre-market window is 04:00-09:29 ET inclusive of its boundaries (EDT and EST)', () => {
+    const bar = (iso: string, h: number) => ({ t: Date.parse(iso), h, l: h, v: 1 });
+    const edt = [bar('2026-10-05T07:59:00.000Z', 900), bar('2026-10-05T08:00:00.000Z', 10), bar('2026-10-05T13:29:00.000Z', 20), bar('2026-10-05T13:30:00.000Z', 900)];
+    expect(computeTapeFacts({ ...base, bars: edt, snapshot: null, dailyVolumes: [] }).premarket).toEqual({ high: 20, low: 10 });
+    const est = [bar('2026-12-07T08:59:00.000Z', 900), bar('2026-12-07T09:00:00.000Z', 30), bar('2026-12-07T14:29:00.000Z', 40), bar('2026-12-07T14:30:00.000Z', 900)];
+    expect(computeTapeFacts({ sessionDate: '2026-12-07', now: new Date('2026-12-07T17:00:00.000Z'), bars: est, snapshot: null, dailyVolumes: [] }).premarket).toEqual({ high: 40, low: 30 });
+  });
+  it('the opening range is 09:30-09:59 ET and is reported only from 10:00 ET', () => {
+    const bar = (iso: string, h: number) => ({ t: Date.parse(iso), h, l: h, v: 1 });
+    const bars = [bar('2026-10-05T13:29:00.000Z', 900), bar('2026-10-05T13:30:00.000Z', 5), bar('2026-10-05T13:59:00.000Z', 6), bar('2026-10-05T14:00:00.000Z', 900)];
+    expect(computeTapeFacts({ ...base, bars, snapshot: null, dailyVolumes: [] }).openingRange).toEqual({ high: 6, low: 5 });
+    expect(computeTapeFacts({ ...base, now: new Date('2026-10-05T13:59:59.000Z'), bars, snapshot: null, dailyVolumes: [] }).openingRange).toBeNull();
+  });
+  it('before 10:00 ET the status is forming when inputs are missing (precedence)', () => {
+    const early = computeTapeFacts({ ...base, now: new Date('2026-10-05T13:45:00.000Z'), snapshot: null, dailyVolumes: [] });
+    expect(classifyTape(early, 'bullish', null)).toMatchObject({ status: 'forming' });
+  });
+  it('bars from another session date are ignored', () => {
+    const other = { t: Date.parse('2026-10-02T13:45:00.000Z'), h: 500, l: 1, v: 1 };
+    expect(computeTapeFacts({ ...base, bars: [other], snapshot: null, dailyVolumes: [] }).openingRange).toBeNull();
+  });
+});
