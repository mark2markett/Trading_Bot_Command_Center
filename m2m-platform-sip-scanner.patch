index 00000000..954ea515
--- /dev/null
+++ b/src/lib/sip/__tests__/http.test.ts
@@ -0,0 +1,97 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import snapshot from "../../../../tests/fixtures/sip/sip-v1-ready.json";
+import { machineResponse } from "../http";
+
+const date = "2026-10-06";
+const secret = "fixture-scanner-secret-32-characters";
+const env = { enabled: "true", secret, reserved: {} };
+const now = new Date(snapshot.generated_at);
+const serve = (value: unknown) => machineResponse(
+  new Request("https://test.invalid/api/internal/cc/sip-scanner", {
+    headers: { Authorization: `Bearer ${secret}` },
+  }), env, async () => value, now,
+);
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("stored SIP snapshot boundary", () => {
+  it.each([
+    ["false", false], ["zero", 0], ["empty string", ""], ["array", []],
+    ["missing fields", {}],
+    ["wrong version", { ...snapshot, version: 2 }],
+    ["wrong status", { ...snapshot, status: "pending" }],
+    ["wrong date", { ...snapshot, session_date: "2026-10-05" }],
+    ["wrong window", { ...snapshot, window_start: "2026-10-06T13:31:00Z" }],
+    ["invalid timestamp", { ...snapshot, generated_at: "invalid" }],
+    ["before window close", { ...snapshot, generated_at: "2026-10-06T13:34:00Z" }],
+    ["missing candidates", { ...snapshot, candidates: null }],
+    ["missing metrics", { ...snapshot, candidates: [{ symbol: "AMD" }] }],
+    ["nonfinite metric", { ...snapshot, candidates: [{ ...snapshot.candidates[0], price: Infinity }] }],
+    ["duplicate candidate", { ...snapshot, candidates: [snapshot.candidates[0], snapshot.candidates[0]] }],
+    ["invalid coverage", { ...snapshot, coverage: { ...snapshot.coverage, observed: -1 } }],
+    ["incomplete coverage", { ...snapshot, coverage: { ...snapshot.coverage, observed: 1 } }],
+    ["missing exclusions", { ...snapshot, exclusions: null }],
+    ["wrong exclusion count", { ...snapshot, exclusions: [{ symbol: "OTHER", reason: "DAILY_LIQUIDITY" }] }],
+    ["outside publication window", { ...snapshot, generated_at: "2026-10-06T13:40:00Z" }],
+    ["fractional coverage", { ...snapshot, coverage: { ...snapshot.coverage, universe: 2.5 } }],
+    ["impossible coverage", { ...snapshot, coverage: { ...snapshot.coverage, universe: 1 } }],
+    ["unqualified metric", { ...snapshot, candidates: [{ ...snapshot.candidates[0], price: 5 }] }],
+    ["invalid exclusion", { ...snapshot, coverage: { ...snapshot.coverage, excluded: 1 }, exclusions: [{ symbol: "OTHER", reason: null }] }],
+    ["unexplained empty result", { ...snapshot, candidates: [] }],
+    ["candidate also excluded", { ...snapshot, coverage: { ...snapshot.coverage, excluded: 1 }, exclusions: [{ symbol: "AMD", reason: "PRICE_TOO_LOW" }] }],
+    ["duplicate exclusions", { ...snapshot, candidates: [], coverage: { ...snapshot.coverage, excluded: 2 },
+      exclusions: [{ symbol: "AMD", reason: "PRICE_TOO_LOW" }, { symbol: "AMD", reason: "PRICE_TOO_LOW" }] }],
+  ])("refuses %s instead of reporting ready", async (_, value) => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const response = await serve(value);
+    expect(response.status).toBe(503);
+    expect(await response.json()).toEqual({ error: "scanner_unavailable" });
+    expect(response.headers.get("Cache-Control")).toContain("no-store");
+  });
+
+  it("serves a valid stored snapshot unchanged", async () => {
+    const response = await serve(snapshot);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual(snapshot);
+  });
+
+  it("keeps valid empty and absent results distinct", async () => {
+    const empty = { ...snapshot, candidates: [], coverage: { universe: 0, eligible: 0, observed: 0, excluded: 0 } };
+    const ready = await serve(empty);
+    expect(ready.status).toBe(200);
+    expect(await ready.json()).toEqual(empty);
+    const pending = await serve(null);
+    expect(pending.status).toBe(202);
+    expect(await pending.json()).toEqual({ version: 1, status: "pending", session_date: date });
+  });
+
+  it("allows price exclusions to overlap eligible coverage and preserves same-session history", async () => {
+    const empty = { ...snapshot, candidates: [], coverage: { universe: 1, eligible: 1, observed: 1, excluded: 1 },
+      exclusions: [{ symbol: "AMD", reason: "PRICE_TOO_LOW" }] };
+    const response = await machineResponse(new Request("https://test.invalid", {
+      headers: { Authorization: `Bearer ${secret}` },
+    }), env, async () => empty, new Date("2026-10-06T20:00:00Z"));
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual(empty);
+  });
+
+  it("accepts the top-20 cap without requiring unreturned qualifying stocks to be excluded", async () => {
+    const capped = { ...snapshot, coverage: { universe: 25, eligible: 25, observed: 25, excluded: 0 },
+      candidates: Array.from({ length: 20 }, (_, i) => ({ ...snapshot.candidates[0], symbol: `STOCK${i}` })) };
+    expect((await serve(capped)).status).toBe(200);
+  });
+
+  it("accepts preparation exclusions outside the eligible observations", async () => {
+    const result = { ...snapshot, coverage: { universe: 3, eligible: 2, observed: 2, excluded: 1 },
+      exclusions: [{ symbol: "OTHER", reason: "ATR_TOO_LOW" }] };
+    expect((await serve(result)).status).toBe(200);
+  });
+
+  it("logs only a bounded invalid-snapshot code without stored contents", async () => {
+    const log = vi.spyOn(console, "error").mockImplementation(() => {});
+    const response = await serve({ private: "private-stored-payload" });
+    expect(response.status).toBe(503);
+    expect(log).toHaveBeenCalledWith("[cc-sip]", JSON.stringify({ sessionDate: date, error: "SIP_SNAPSHOT_INVALID" }));
+    expect(await response.text()).not.toContain("private-stored-payload");
+  });
+});
