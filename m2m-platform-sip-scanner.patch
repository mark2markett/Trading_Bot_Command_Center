diff --git a/src/lib/slate/planPositioning.ts b/src/lib/slate/planPositioning.ts
new file mode 100644
index 00000000..5eb65239
--- /dev/null
+++ b/src/lib/slate/planPositioning.ts
@@ -0,0 +1,154 @@
+/**
+ * Short positioning for the Slate's stock names, read from Ortex data that is already bought (owner
+ * decision ORTEX-SLATE-1, 2026-10-05). CACHE-ONLY: this module never calls Ortex and spends no
+ * credits; the page and the interpretation job only read what other jobs stored.
+ *
+ *   bulk      the daily Ortex S&P 500 positioning snapshot (latest COMPLETE manifest): short interest
+ *             as % of free float, days to cover, cost to borrow (all loans), shares available to borrow.
+ *             Ortex's `short_availability_pct` is NOT used: it does not equal available ÷ short or a share
+ *             of float, so its meaning is unverified; only its 9999 "unconstrained" sentinel is read.
+ *   targeted  a name outside that snapshot: the newest per-ticker short-interest history in
+ *             `ortex_cache` (written by the scanner and the plan-positioning job). Short interest
+ *             only; Ortex's per-name borrow-rate endpoint is not usable on this account.
+ *
+ * Vendor values render plain. Two values are derived (Rule 3: vendor inputs, a ratio a reader can
+ * redo) and render est.: the change over POSITIONING_CHANGE_SESSIONS snapshots, and shares available
+ * to borrow ÷ shares already short.
+ */
+
+import { supabaseRest } from '@/lib/db';
+import { parseOrtexRow } from '@/services/ortexParsing';
+
+/** Compare against the snapshot this many sessions earlier. */
+export const POSITIONING_CHANGE_SESSIONS = 5;
+/** Ortex sends 9999 for "no borrow constraint"; it is not a percentage. */
+export const ORTEX_AVAILABILITY_UNLIMITED = 9999;
+
+const SYMBOL_RE = /^[A-Z0-9]+(?:[.-][A-Z0-9]+)*$/;
+
+export interface PlanPositioning {
+  symbol: string;
+  source: 'bulk' | 'targeted';
+  /** Vendor data date of the latest value. */
+  asOf: string;
+  siPctFreeFloat: number | null;
+  /** Value and date of the comparison point (POSITIONING_CHANGE_SESSIONS earlier), when on file. */
+  siPctFreeFloatPrior: number | null;
+  priorAsOf: string | null;
+  /** Relative change of short interest vs the comparison point, in percent (derived). */
+  siChangePct: number | null;
+  daysToCover: number | null;
+  costToBorrowPct: number | null;
+  /** Shares available to borrow ÷ shares sold short (derived). */
+  availVsShort: number | null;
+  availabilityUnlimited: boolean;
+}
+
+export interface PlanPositioningRead {
+  /** ok: the reads ran (a name may still have no row). read_failed: a store read threw. */
+  status: 'ok' | 'read_failed';
+  bySymbol: Record<string, PlanPositioning>;
+}
+
+type Rest = typeof supabaseRest;
+type Row = Record<string, unknown>;
+
+const num = (v: unknown): number | null => {
+  const n = typeof v === 'number' ? v : typeof v === 'string' && v.trim() !== '' ? Number(v) : NaN;
+  return Number.isFinite(n) ? n : null;
+};
+
+/** Whole-percent change with a sign; a change that rounds to zero is "0%", never "-0%". */
+export const signedPct = (x: number) => { const v = Math.round(x); return v === 0 ? '0%' : `${v > 0 ? '+' : ''}${v}%`; };
+
+export function relChangePct(now: number | null, prior: number | null): number | null {
+  return now !== null && prior !== null && prior > 0 ? ((now - prior) / prior) * 100 : null;
+}
+
+/** Pure: a bulk snapshot row (and the same name's row from the comparison snapshot). */
+export function fromSnapshot(row: Row, prior: Row | undefined, priorAsOf: string | null): PlanPositioning {
+  const si = num(row.si_pct_free_float);
+  const priorSi = prior ? num(prior.si_pct_free_float) : null;
+  const sentinel = num(row.short_availability_pct);
+  const unlimited = sentinel !== null && sentinel >= ORTEX_AVAILABILITY_UNLIMITED;
+  const availShares = num(row.short_availability_shares);
+  const siShares = num(row.si_shares);
+  return {
+    symbol: String(row.symbol),
+    source: 'bulk',
+    asOf: String(row.source_date),
+    siPctFreeFloat: si,
+    siPctFreeFloatPrior: priorSi,
+    priorAsOf: priorSi !== null ? priorAsOf : null,
+    siChangePct: relChangePct(si, priorSi),
+    daysToCover: num(row.days_to_cover),
+    costToBorrowPct: num(row.cost_to_borrow_all),
+    availVsShort: unlimited || availShares === null || siShares === null || siShares <= 0 ? null : availShares / siShares,
+    availabilityUnlimited: unlimited,
+  };
+}
+
+/** Pure: a per-ticker short-interest history (oldest first, as Ortex returns it). */
+export function fromHistory(symbol: string, rows: unknown): PlanPositioning | null {
+  if (!Array.isArray(rows)) return null;
+  const parsed = rows.map(r => parseOrtexRow(symbol, r)).filter((r): r is NonNullable<typeof r> => r !== null);
+  const last = parsed.at(-1);
+  if (!last) return null;
+  const prior = parsed.length > POSITIONING_CHANGE_SESSIONS ? parsed[parsed.length - 1 - POSITIONING_CHANGE_SESSIONS] : undefined;
+  return {
+    symbol,
+    source: 'targeted',
+    asOf: last.date,
+    siPctFreeFloat: last.shortInterestPct,
+    siPctFreeFloatPrior: prior?.shortInterestPct ?? null,
+    priorAsOf: prior?.date ?? null,
+    siChangePct: relChangePct(last.shortInterestPct, prior?.shortInterestPct ?? null),
+    daysToCover: null,
+    costToBorrowPct: null,
+    availVsShort: null,
+    availabilityUnlimited: false,
+  };
+}
+
+const inList = (symbols: string[]) => encodeURIComponent(`(${symbols.map(s => `"${s}"`).join(',')})`);
+
+/** Cache-only read for the given names: bulk snapshot first, then the per-ticker cache. */
+export async function readPlanPositioning(symbols: string[], rest: Rest = supabaseRest): Promise<PlanPositioningRead> {
+  const list = Array.from(new Set(symbols.map(s => s.toUpperCase()).filter(s => SYMBOL_RE.test(s))));
+  if (list.length === 0) return { status: 'ok', bySymbol: {} };
+  const bySymbol: Record<string, PlanPositioning> = {};
+  try {
+    const manifests = await rest('ortex_positioning_manifests', 'GET', {
+      query: `status=eq.COMPLETE&select=source_date&order=source_date.desc&limit=${POSITIONING_CHANGE_SESSIONS + 1}`,
+    }) as Row[];
+    const dates = (Array.isArray(manifests) ? manifests : []).map(m => m.source_date).filter((d): d is string => typeof d === 'string');
+    const latest = dates[0] ?? null;
+    const priorDate = dates[POSITIONING_CHANGE_SESSIONS] ?? null;
+    if (latest) {
+      const cols = 'symbol,source_date,si_shares,si_pct_free_float,days_to_cover,cost_to_borrow_all,short_availability_shares,short_availability_pct';
+      const [rows, priorRows] = await Promise.all([
+        rest('ortex_positioning_snapshots', 'GET', { query: `source_date=eq.${latest}&symbol=in.${inList(list)}&select=${cols}` }) as Promise<Row[]>,
+        priorDate
+          ? rest('ortex_positioning_snapshots', 'GET', { query: `source_date=eq.${priorDate}&symbol=in.${inList(list)}&select=symbol,si_pct_free_float` }) as Promise<Row[]>
+          : Promise.resolve([] as Row[]),
+      ]);
+      const prior = new Map((Array.isArray(priorRows) ? priorRows : []).map(r => [String(r.symbol), r]));
+      for (const r of Array.isArray(rows) ? rows : []) bySymbol[String(r.symbol)] = fromSnapshot(r, prior.get(String(r.symbol)), priorDate);
+    }
+    const rest2 = list.filter(s => !bySymbol[s]);
+    if (rest2.length > 0) {
+      const cached = await rest('ortex_cache', 'GET', {
+        query: `ticker=in.${inList(rest2)}&data_type=eq.history&select=ticker,data_json,fetched_at&order=fetched_at.desc`,
+      }) as Row[];
+      for (const r of Array.isArray(cached) ? cached : []) {
+        const sym = String(r.ticker);
+        if (bySymbol[sym]) continue; // newest row per ticker wins (ordered desc)
+        const p = fromHistory(sym, r.data_json);
+        if (p) bySymbol[sym] = p;
+      }
+    }
+    return { status: 'ok', bySymbol };
+  } catch {
+    return { status: 'read_failed', bySymbol: {} };
+  }
+}
diff --git a/supabase/migrations/20261006164647_plan_interpretations_read_slot.sql b/supabase/migrations/20261006164647_plan_interpretations_read_slot.sql
new file mode 100644
index 00000000..389fe898
--- /dev/null
+++ b/supabase/migrations/20261006164647_plan_interpretations_read_slot.sql
@@ -0,0 +1,21 @@
+-- DAY-READS-1 (owner approved 2026-10-06: "approve the read_slot migration"). Which read a
+-- plan_interpretations row is: the nightly plan read (all existing rows) or one of the four daytime
+-- reads. Additive: existing rows become 'nightly'. The one-ok-row guarantee becomes per read slot, so a
+-- daytime read never replaces or blocks the nightly graded read (EXPERT-READ-GRADING-1 scores 'nightly').
+-- Applied to production 2026-10-06 as version 20261006164647 (Supabase MCP apply_migration).
+alter table public.plan_interpretations
+  add column if not exists read_slot text not null default 'nightly';
+
+alter table public.plan_interpretations
+  drop constraint if exists plan_interpretations_read_slot_check;
+alter table public.plan_interpretations
+  add constraint plan_interpretations_read_slot_check
+  check (read_slot in ('nightly', '09:00', '11:00', '13:00', '15:00'));
+
+drop index if exists public.plan_interpretations_one_ok_idx;
+create unique index plan_interpretations_one_ok_idx
+  on public.plan_interpretations (session_date, read_slot, prompt_version, system_prompt_hash)
+  where status = 'ok';
+
+create index if not exists plan_interpretations_slot_idx
+  on public.plan_interpretations (session_date desc, read_slot, created_at desc);
